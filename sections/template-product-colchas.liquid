padding:18px;
border-radius:14px;
}

.ls-includes div{
padding:6px 0;
font-weight:600;
color:#166534;
}
</style>

{% assign current_variant = product.selected_or_first_available_variant %}
<div class="ls-container" id="product-section-{{ section.id }}">
  {% if section.settings.show_urgency %}
    <div class="ls-urgency">
      {{ section.settings.urgency_text }}
    </div>
  {% endif %}

  <div class="ls-wrapper">
    <div class="ls-hero">
      <!-- Lado Izquierdo: Galería -->
      <div class="ls-hero-left">
        <!-- Título Móvil -->
        <div class="mobile-only-title" style="margin-bottom: 20px;">
          <div class="ls-reviews-snippet">
            <span class="ls-stars">★★★★★</span>
            <span>4.9/5 ({{ section.settings.review_count }} Opiniones)</span>
          </div>
          <h1 class="ls-title">{{ section.settings.headline | default: product.title }}</h1>
          {% if section.settings.subheadline != blank %}
            <p class="ls-subtitle">{{ section.settings.subheadline }}</p>
          {% endif %}
        </div>

        <div class="ls-gallery" id="ls-main-gallery">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              <div class="ls-media-item" data-media-id="{{ media.id }}" {% unless forloop.first %}style="display: none;"{% endunless %}>
                {% case media.media_type %}
                  {% when 'video' %}
                    {{ media | video_tag: controls: true, autoplay: true, loop: true, style: "width: 100%; height: auto; max-height: 65vh; display: block;" }}
                  {% when 'external_video' %}
                    {{ media | external_video_tag: style: "width: 100%; height: auto; max-height: 65vh; display: block;" }}
                  {% else %}
                    <img src="{{ media | image_url: width: 800 }}" alt="{{ media.alt | escape }}" class="ls-main-img" width="800" height="800" loading="eager" {% if forloop.first %}fetchpriority="high"{% else %}fetchpriority="low"{% endif %} style="width: 100%; height: auto; display: block; object-fit: cover; max-height: 65vh;">
                {% endcase %}
              </div>
            {% endfor %}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'ls-main-img' }}
          {% endif %}
        </div>
        
        {% if product.media.size > 1 %}
        <div class="ls-thumbnails">
          {% for media in product.media %}
            <div class="ls-thumb-wrapper ls-thumb {% if forloop.first %}active{% endif %}" onclick="changeLsMedia(this, '{{ media.id }}')" style="cursor: pointer; position: relative;">
              <img src="{{ media.preview_image | image_url: width: 150 }}" alt="{{ media.alt | default: product.title | escape }}" width="75" height="75" loading="eager" fetchpriority="high" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;">
              {% if media.media_type == 'video' or media.media_type == 'external_video' %}
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: white; background: rgba(0,0,0,0.5); border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; font-size: 12px; padding-left: 2px; pointer-events: none;">▶</div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
        {% endif %}
        <div class="ls-easy-sell-mount" data-easy-sell-mount></div>
        {% if section.settings.trust_image != blank %}
          <div class="ls-mobile-trust ls-micro-trust ls-micro-trust-image-wrap">
            <img src="{{ section.settings.trust_image | image_url: width: 1600 }}" alt="{{ section.settings.trust_image.alt | default: 'Beneficios de compra' | escape }}" class="ls-micro-trust-image" loading="eager" style="display:block;width:100%;height:100%;max-width:100%;">
          </div>
        {% endif %}
      </div>

      <!-- Lado Derecho: Formulario y Compra -->
      <div class="ls-hero-right">
        
        <!-- Título Escritorio -->
        <div class="desktop-only-title" style="margin-bottom: 25px;">
          <div class="ls-reviews-snippet">
            <span class="ls-stars">★★★★★</span>
            <span>4.9/5 ({{ section.settings.review_count }} Opiniones)</span>
          </div>
          <h1 class="ls-title">{{ section.settings.headline | default: product.title }}</h1>
          {% if section.settings.subheadline != blank %}
            <p class="ls-subtitle">{{ section.settings.subheadline }}</p>
          {% endif %}
        </div>

        <div style="text-align: center; margin-bottom: 20px;">
          {% render 'custom-countdown' %}
        </div>
        <div class="ls-price-box">
          <span class="ls-price" id="ls-price">{{ current_variant.price | money }}</span>
          <span class="ls-compare" id="ls-compare" {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>{{ current_variant.compare_at_price | money }}</span>
          <span class="ls-save-badge" id="ls-badge" {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>
            {% if current_variant.compare_at_price > current_variant.price %}
              {% assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price %}
              -{{ discount_pct }}%
            {% endif %}
          </span>
        </div>

        {% if section.settings.trust_image != blank %}
        <div class="ls-desktop-trust ls-micro-trust ls-micro-trust-image-wrap">
          <img src="{{ section.settings.trust_image | image_url: width: 1600 }}" alt="{{ section.settings.trust_image.alt | default: 'Beneficios de compra' | escape }}" class="ls-micro-trust-image" loading="eager" style="display:block;width:100%;height:100%;max-width:100%;">
        </div>
        {% else %}
        <div class="ls-micro-trust">
          <div>🚚 Envío GRATIS a toda Colombia</div>
          <div>💰 Pago contra entrega</div>
          <div>⭐ Más de 2.000 juegos vendidos</div>
          <div>🔒 Compra 100% segura</div>
        </div>
        {% endif %}
      
        
        <div>
          {% form 'product', product, id: 'landing-product-form', class: 'ls-form releasit-form' %}
            <input type="hidden" name="id" id="ls-variant-id" value="{{ current_variant.id }}">
            <input type="hidden" name="quantity" value="1">

            {% unless product.has_only_default_variant %}
              {% for option in product.options_with_values %}
                {% assign option_name_downcase = option.name | downcase %}
                <div class="ls-variant-group">
                  <label class="ls-variant-label">{{ option.name }}: <span id="ls-val-{{ option.position }}">{{ option.selected_value }}</span></label>
                  <div class="ls-swatches">
                    {% for value in option.values %}
                      {% if option_name_downcase contains 'color' or option_name_downcase contains 'colour' %}
                        {% assign variant_img = '' %}
                        {% for v in product.variants %}
                          {% if v.options contains value and v.featured_image %}
                            {% assign variant_img = v.featured_image | image_url: width: 120 %}
                            {% break %}
                          {% endif %}
                        {% endfor %}
                        <div class="ls-swatch-color {% if option.selected_value == value %}active{% endif %}" 
                             data-option-index="{{ option.position }}" 
                             data-value="{{ value | escape }}"
                             onclick="selectLsVariant(this)"
                             {% if variant_img != '' %}
                             style="background-image: url('{{ variant_img }}'); background-size: cover; background-position: center;"
                             {% else %}
                             style="background-color: {{ value | split: ' ' | last | downcase }};"
                             {% endif %}
                             title="{{ value }}">
                        </div>
                      {% else %}
                        <div class="ls-swatch-size {% if option.selected_value == value %}active{% endif %}" 
                             data-option-index="{{ option.position }}" 
                             data-value="{{ value | escape }}"
                             onclick="selectLsVariant(this)">
                          {{ value }}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            {% endunless %}
            <input type="hidden" name="add" value="1">
           
          {% endform %}
        </div>

        <div class="ls-objections">
          <div>🚚 Entrega de 2 a 5 días hábiles</div>
          <div>↩️ Cambios por defectos de fabricación</div>
          <div>💳 Pago al recibir</div>
          <div>📞 Soporte por WhatsApp</div>
        </div>
      
        <div class="ls-trust">
          <div class="ls-trust-item">
