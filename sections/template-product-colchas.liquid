    if (matchingVariant) {
      document.getElementById('ls-variant-id').value = matchingVariant.id;
      document.getElementById('ls-variant-id').dispatchEvent(new Event('change', { bubbles: true }));  // <-- nueva línea
      
      var variantData = lsVariantPrices[matchingVariant.id];

      
      var variantData = lsVariantPrices[matchingVariant.id];
      if (variantData) {
        document.getElementById('ls-price').innerHTML = variantData.price;
        if (variantData.has_discount) {
          document.getElementById('ls-compare').style.display = 'inline-block';
