<script>
  var lsVariantPrices = {
    {% for variant in product.variants %}
      "{{ variant.id }}": {
        "price": "{{ variant.price | money }}",
        "compare_at_price": "{{ variant.compare_at_price | money }}",
        "has_discount": {% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %},
        "discount_pct": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round }}{% else %}0{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  function changeLsMedia(thumb, mediaId) {
    document.querySelectorAll('.ls-media-item').forEach(el => {
      el.style.display = 'none';
      var video = el.querySelector('video');
      if (video) video.pause();
    });
    
    var activeMedia = document.querySelector('.ls-media-item[data-media-id="' + mediaId + '"]');
    if (activeMedia) {
      activeMedia.style.display = 'block';
      var video = activeMedia.querySelector('video');
      if (video) video.play();
    }
    
    document.querySelectorAll('.ls-thumb-wrapper').forEach(el => el.classList.remove('active'));
    if(thumb) {
      thumb.classList.add('active');
    }
  }

  var lsProductJson = {{ product | json }};

  function selectLsVariant(swatch) {
    var optionIndex = parseInt(swatch.getAttribute('data-option-index'));
    var value = swatch.getAttribute('data-value');
    
    var container = swatch.closest('.ls-variant-group');
    container.querySelectorAll('.ls-swatch-color, .ls-swatch-size').forEach(el => el.classList.remove('active'));
    swatch.classList.add('active');
    
    document.getElementById('ls-val-' + optionIndex).textContent = value;
    
    updateAvailableOptions(optionIndex, value);
    updateLsVariant(false);
  }

  function updateAvailableOptions(changedOptionIndex, changedValue) {
    var availableVariants = lsProductJson.variants.filter(function(v) {
      return v.options[changedOptionIndex - 1] === changedValue;
    });

    var allGroups = document.querySelectorAll('.ls-variant-group');
    allGroups.forEach(function(group) {
      var swatches = group.querySelectorAll('.ls-swatch-color, .ls-swatch-size');
      if (swatches.length === 0) return;
      var currentOptionIndex = parseInt(swatches[0].getAttribute('data-option-index'));
      
      if (currentOptionIndex === changedOptionIndex) return;

      var possibleValues = availableVariants.map(function(v) { return v.options[currentOptionIndex - 1]; });
      
      var hasActiveVisible = false;
      var firstVisibleSwatch = null;

      swatches.forEach(function(sw) {
        var val = sw.getAttribute('data-value');
        if (possibleValues.includes(val)) {
          sw.style.display = '';
          if (!firstVisibleSwatch) firstVisibleSwatch = sw;
          if (sw.classList.contains('active')) hasActiveVisible = true;
        } else {
          sw.style.display = 'none';
          sw.classList.remove('active');
        }
      });

      if (!hasActiveVisible && firstVisibleSwatch) {
        firstVisibleSwatch.classList.add('active');
        document.getElementById('ls-val-' + currentOptionIndex).textContent = firstVisibleSwatch.getAttribute('data-value');
      }
    });
  }

  function updateLsVariant(preventImageSwitch) {
    var selectedOptions = [];
    document.querySelectorAll('.ls-variant-group').forEach(function(group) {
      var activeSwatch = group.querySelector('.ls-swatch-color.active, .ls-swatch-size.active');
      if (activeSwatch) {
        selectedOptions[parseInt(activeSwatch.getAttribute('data-option-index')) - 1] = activeSwatch.getAttribute('data-value');
      }
    });

    var matchingVariant = lsProductJson.variants.find(function(variant) {
      return variant.options.every(function(opt, i) {
        return opt === selectedOptions[i];
      });
    });

    if (matchingVariant) {
      document.getElementById('ls-variant-id').value = matchingVariant.id;
      document.getElementById('ls-variant-id').dispatchEvent(new Event('change', { bubbles: true }));
      
      var variantData = lsVariantPrices[matchingVariant.id];
      if (variantData) {
        document.getElementById('ls-price').innerHTML = variantData.price;
        if (variantData.has_discount) {
          document.getElementById('ls-compare').style.display = 'inline-block';
          document.getElementById('ls-compare').innerHTML = variantData.compare_at_price;
          document.getElementById('ls-badge').innerHTML =
'🔥 ' + variantData.discount_pct + '% OFF';
          document.getElementById('ls-badge').style.display = 'inline-block';
        } else {
          document.getElementById('ls-compare').style.display = 'none';
          document.getElementById('ls-badge').style.display = 'none';
        }
      }
    }
  }

  {% comment %} function updateLsVariant(preventImageSwitch) {
    var selectedOptions = [];
    document.querySelectorAll('.ls-variant-group').forEach(function(group) {
      var activeSwatch = group.querySelector('.ls-swatch-color.active, .ls-swatch-size.active');
      if (activeSwatch) {
        selectedOptions[parseInt(activeSwatch.getAttribute('data-option-index')) - 1] = activeSwatch.getAttribute('data-value');
