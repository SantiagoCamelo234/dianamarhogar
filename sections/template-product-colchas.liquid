      } {% endcomment %}
      
      {% comment %} if (matchingVariant.featured_media) {
        var mediaId = matchingVariant.featured_media.id;
        var thumb = document.querySelector('.ls-thumb-wrapper[onclick*="' + mediaId + '"]');
        if (thumb) changeLsMedia(thumb, mediaId);
      } else if (matchingVariant.featured_image) {
        var filename = matchingVariant.featured_image.src.split('/').pop().split('?')[0];
        var found = false;
        document.querySelectorAll('.ls-media-item').forEach(function(item) {
          if (!found) {
            var img = item.querySelector('img');
            if (img && img.src.includes(filename)) {
              var mediaId = item.getAttribute('data-media-id');
              var thumb = document.querySelector('.ls-thumb-wrapper[onclick*="' + mediaId + '"]');
              changeLsMedia(thumb, mediaId);
              found = true;
            }
          }
        });
      }
    }
  } {% endcomment %}



  if (typeof Shopify === 'undefined') {
    Shopify = {};
  }
  if (!Shopify.formatMoney) {
    Shopify.formatMoney = function(cents, format) {
      if (typeof cents == 'string') { cents = cents.replace('.',''); }
      var value = '';
      var placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
      var formatString = (format || this.money_format);

      function defaultOption(opt, def) {
         return (typeof opt == 'undefined' ? def : opt);
      }

      function formatWithDelimiters(number, precision, thousands, decimal) {
        precision = defaultOption(precision, 2);
        thousands = defaultOption(thousands, ',');
        decimal   = defaultOption(decimal, '.');

        if (isNaN(number) || number == null) { return 0; }

        number = (number/100.0).toFixed(precision);

        var parts   = number.split('.'),
            dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '' + thousands),
            cents   = parts[1] ? (decimal + parts[1]) : '';

        return dollars + cents;
      }

      switch(formatString.match(placeholderRegex)[1]) {
        case 'amount':
          value = formatWithDelimiters(cents, 2);
          break;
        case 'amount_no_decimals':
          value = formatWithDelimiters(cents, 0);
          break;
        case 'amount_with_comma_separator':
          value = formatWithDelimiters(cents, 2, '.', ',');
          break;
        case 'amount_no_decimals_with_comma_separator':
          value = formatWithDelimiters(cents, 0, '.', ',');
          break;
      }
      return formatString.replace(placeholderRegex, value);
    };
  }
  function showMoreReviews(btn) {
    document.querySelectorAll('.ls-review-hidden').forEach(el => el.classList.remove('ls-review-hidden'));
    btn.style.display = 'none';
  }

  document.addEventListener('DOMContentLoaded', function() {
    var firstActive = document.querySelector('.ls-variant-group .active');
    if (firstActive) {
      var optionIndex = parseInt(firstActive.getAttribute('data-option-index'));
      var value = firstActive.getAttribute('data-value');
      updateAvailableOptions(optionIndex, value);
      updateLsVariant();
    }
  });

  function toggleReviewForm() {
    var formContainer = document.getElementById('ls-review-form-container');
    if (formContainer.style.display === 'none') {
      formContainer.style.display = 'block';
    } else {
      formContainer.style.display = 'none';
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    var stars = document.querySelectorAll('#ls-star-rating span');
    stars.forEach(function(star) {
      star.addEventListener('click', function() {
        var val = parseInt(this.getAttribute('data-value'));
        document.getElementById('ls-rating-val').value = val;
        stars.forEach(function(s) {
          if (parseInt(s.getAttribute('data-value')) <= val) {
            s.classList.add('active');
            s.style.color = '#f5a623';
          } else {
            s.classList.remove('active');
            s.style.color = '#ccc';
          }
        });
      });
    });
  });

  function submitReviewForm(e) {
    e.preventDefault();
    if(!document.getElementById('ls-rating-val').value) {
      alert('Por favor selecciona una calificación de estrellas.');
      return;
    }
    document.getElementById('ls-real-review-form').style.display = 'none';
    document.getElementById('ls-review-success').style.display = 'block';
  }


    // Swipe support for main gallery
  document.addEventListener('DOMContentLoaded', function() {
    var gallery = document.getElementById('ls-main-gallery');
    if(gallery) {
      var startX = 0;
      var endX = 0;
      
      gallery.addEventListener('touchstart', function(e) {
        startX = e.changedTouches[0].screenX;
      }, {passive: true});
      
      gallery.addEventListener('touchend', function(e) {
        endX = e.changedTouches[0].screenX;
        handleSwipe();
      }, {passive: true});
      
      function handleSwipe() {
        var threshold = 40;
        if (endX < startX - threshold) {
          navigateGallery(1); // swipe left -> next
        }
        if (endX > startX + threshold) {
          navigateGallery(-1); // swipe right -> prev
        }
      }

      function navigateGallery(direction) {
        var items = Array.from(document.querySelectorAll('.ls-media-item'));
        if(items.length <= 1) return;
        
        var currentIndex = items.findIndex(function(el) {
          return el.style.display !== 'none';
        });
        
        if (currentIndex === -1) currentIndex = 0;
        
        var nextIndex = currentIndex + direction;
        if (nextIndex < 0) nextIndex = items.length - 1;
        if (nextIndex >= items.length) nextIndex = 0;
        
        var nextMediaId = items[nextIndex].getAttribute('data-media-id');
        var thumb = document.querySelector('.ls-thumb-wrapper[onclick*="' + nextMediaId + '"]');
        
        changeLsMedia(thumb, nextMediaId);
        
        if(thumb) {
          thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      }
    }
  });
</script>

