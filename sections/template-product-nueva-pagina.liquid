{% comment %}
  NUEVA PÁGINA DE PRODUCTO
  Plantilla: templates/product.nueva-pagina.liquid
  Para usarla: Admin de Shopify > Productos > (producto) > Plantilla del tema > "nueva-pagina".

  La compra la maneja ReleasIT: su botón se inserta automáticamente dentro del
  formulario de producto de abajo (#landing-product-form). Los botones
  "Pedir ahora" del resto de la página abren ese mismo botón de ReleasIT, así
  que la variante (color + tamaño) elegida siempre viaja al formulario.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Figtree:wght@400;500;600;700;800&display=swap">

<style>
  .nv-page {
    --nv-coral: #E8746A;
    --nv-coral-soft: #F4A99C;
    --nv-blush: #FCEFEC;
    --nv-blush-2: #FFF7F5;
    --nv-cta: #e60023;
    --nv-cta-dark: #b8001a;
    --nv-ink: #2c2c2c;
    --nv-text: #4a3f3d;
    --nv-muted: #8a7a77;
    --nv-line: #F0DEDA;
    --nv-paper: #ffffff;
    --nv-ok: #15803d;
    --nv-star: #f5a623;
    background: var(--nv-paper);
    color: var(--nv-text);
    font-family: "Figtree", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.55;
    width: 100%;
    overflow-x: hidden;
    overflow-x: clip; /* clip (no hidden) para que el fondo y la galería "sticky" funcionen */
    overflow-y: clip; /* el fondo animado no se sale de la página (no tapa el footer) */
    position: relative;
    isolation: isolate;
  }

  /* Sin franja en blanco entre la página y el footer */
  body:has(.nv-page) footer { margin-top: 0; position: relative; z-index: 1; background-color: #3d4f45; }

  /* Fondo animado con las portadas de las sábanas */
  .nv-bg { position: sticky; top: 0; height: 100vh; margin-bottom: -100vh; overflow: hidden; z-index: -1; pointer-events: none; }
  .nv-bg-mosaic { position: absolute; top: -40%; left: -40%; width: 180%; display: grid; grid-template-columns: repeat(6, 1fr); gap: 18px; transform: rotate(-8deg); animation: nv-bg-drift 70s linear infinite; }
  .nv-bg-tile { aspect-ratio: 1; border-radius: 18px; background-size: cover; background-position: center; opacity: .16; }
  @keyframes nv-bg-drift { from { translate: 0 0; } to { translate: 0 calc(-50% - 9px); } }
  @media (max-width: 768px) {
    .nv-bg-mosaic { grid-template-columns: repeat(4, 1fr); gap: 12px; width: 200%; left: -50%; }
    .nv-bg-tile { opacity: .14; }
    @keyframes nv-bg-drift { from { translate: 0 0; } to { translate: 0 calc(-50% - 6px); } }
  }
  .nv-page *, .nv-page *::before, .nv-page *::after { box-sizing: border-box; }
  .nv-page h1, .nv-page h2, .nv-page h3 { font-family: "Young Serif", Georgia, "Times New Roman", serif; color: var(--nv-ink); font-weight: 400; text-wrap: balance; margin: 0; }
  .nv-page p { margin: 0; }
  .nv-page img { max-width: 100%; }
  .nv-wrap { max-width: 1120px; margin-inline: auto; padding-inline: 16px; }
  .nv-sec { padding-block: 56px; }
  .nv-alt { background: rgba(255, 247, 245, .72); }
  .nv-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--nv-coral); }
  .nv-head { display: grid; gap: 8px; text-align: center; max-width: 640px; margin: 0 auto 32px; }
  .nv-head h2 { font-size: clamp(26px, 4vw, 36px); line-height: 1.15; }
  .nv-head p { color: var(--nv-muted); }

  /* Botones */
  .nv-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 0; cursor: pointer; font: inherit; font-weight: 700; border-radius: 10px; padding: 16px 22px; text-decoration: none; transition: transform .15s, background .15s; text-align: center; }
  .nv-btn-cta { background: var(--nv-cta); color: #fff !important; font-size: 17px; box-shadow: 0 6px 18px rgba(230,0,35,.25); }
  .nv-btn-cta:hover { background: var(--nv-cta-dark); transform: translateY(-1px); }
  .nv-btn-ghost { background: transparent; color: var(--nv-ink) !important; border: 1.5px solid var(--nv-line); }
  .nv-btn-ghost:hover { border-color: var(--nv-coral); }
  .nv-btn-block { width: 100%; }
  .nv-page .nv-btn:focus-visible, .nv-page .ls-swatch-color:focus-visible, .nv-page .ls-swatch-size:focus-visible, .nv-page .nv-tier:focus-visible, .nv-page summary:focus-visible { outline: 3px solid var(--nv-coral); outline-offset: 2px; }

  /* HERO */
  .nv-hero { padding-block: 28px 48px; background: linear-gradient(180deg, rgba(255,247,245,.85), rgba(255,255,255,.55)); }
  .nv-hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 40px; align-items: start; }
  .nv-hero-grid > * { min-width: 0; }
  .nv-gallery-col { display: grid; gap: 12px; position: sticky; top: 16px; }
  /* Galería como en el boceto: marco 4:5 sobre blanco, la foto completa sin recortes */
  .ls-gallery { position: relative; width: 100%; aspect-ratio: 4 / 5; border-radius: 18px; overflow: hidden; background: #fff; }
  .ls-media-item { position: absolute; inset: 0; }
  .ls-media-item img, .ls-media-item video, .ls-media-item iframe { width: 100%; height: 100%; display: block; object-fit: contain; max-height: none; border: 0; }
  .ls-media-variant-hidden, .ls-thumb-variant-hidden { display: none !important; }
  .nv-badge-float { position: absolute; top: 14px; left: 14px; z-index: 2; background: #fff; color: var(--nv-ink); font-size: 13px; font-weight: 700; padding: 7px 12px; border-radius: 999px; box-shadow: 0 4px 12px rgba(0,0,0,.08); pointer-events: none; }
  .nv-badge-float.nv-r { left: auto; right: 14px; background: #B8473D; color: #fff; font-weight: 800; font-size: 14px; box-shadow: none; }
  .ls-thumbnails { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 4px; scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none; }
  .ls-thumbnails::-webkit-scrollbar { display: none; }
  .ls-thumb-wrapper { width: 76px; height: 76px; flex-shrink: 0; border-radius: 10px; border: 2px solid transparent; background: #fff; cursor: pointer; scroll-snap-align: start; transition: border-color .2s; overflow: hidden; }
  .ls-thumb-wrapper.active { border-color: #B8473D; }
  .ls-thumb-wrapper:hover { border-color: var(--nv-coral-soft); }
  .ls-thumb-wrapper.active:hover { border-color: #B8473D; }

  .nv-buy { display: grid; gap: 18px; }
  .nv-stars { color: var(--nv-star); letter-spacing: 2px; font-size: 16px; }
  .nv-rating { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 14px; color: var(--nv-muted); }
  .nv-hero h1 { font-size: clamp(28px, 4.2vw, 42px); line-height: 1.12; }
  .nv-lead { font-size: 17px; }
  .nv-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .nv-pill { background: var(--nv-blush); color: var(--nv-ink); font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 999px; }

  .nv-price-block { display: grid; gap: 10px; }
  .nv-perks { display: flex; flex-wrap: wrap; gap: 6px; }
  .nv-perk { display: inline-flex; align-items: center; gap: 5px; background: #E8F3E9; color: #1F5E23; font-weight: 700; font-size: 13px; padding: 5px 11px; border-radius: 999px; }
  .nv-rating a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .nv-tiers-hero { display: grid; gap: 8px; }
  .nv-qty-label { font-weight: 700; color: var(--nv-ink); font-size: 14px; }
  .nv-tiers-hero .nv-tiers { gap: 10px; max-width: none; margin: 0; padding-top: 4px; }
  .nv-tiers-hero .nv-tier { padding: 12px 14px; gap: 12px; }
  .nv-tiers-hero .nv-tier-sub { font-size: 12.5px; }
  .nv-price-row { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; padding-block: 4px; }
  .nv-price { font-size: 34px; font-weight: 800; color: var(--nv-ink); line-height: 1; font-variant-numeric: tabular-nums; }
  .nv-compare { color: var(--nv-muted); text-decoration: line-through; font-size: 18px; }
  .nv-save { background: var(--nv-coral); color: #fff; font-weight: 800; font-size: 15px; padding: 6px 14px; border-radius: 999px; box-shadow: 0 6px 20px rgba(232,116,106,.35); }

  .ls-form { display: grid; gap: 18px; }
  .ls-variant-group { display: grid; gap: 8px; }
  .ls-variant-group.nv-missing { animation: nv-shake .4s; }
  .ls-variant-group.nv-missing .ls-variant-label span { color: var(--nv-cta); font-weight: 700; }
  .nv-choose-msg { margin: 10px 0 0; padding: 10px 12px; border-radius: 10px; background: #fff1f2; border: 1px solid #fecdd3; color: #b4232f; font-weight: 700; font-size: 14px; text-align: center; }
  .nv-choose-msg-top { margin: 0 0 4px; }
  @keyframes nv-shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
  .ls-variant-label { font-weight: 700; color: var(--nv-ink); font-size: 14px; }
  .ls-variant-label span { font-weight: 500; color: var(--nv-coral); }
  .ls-swatches { display: flex; flex-wrap: wrap; gap: 10px; }
  .ls-swatch-color { width: 48px; height: 48px; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 0 0 1.5px var(--nv-line); cursor: pointer; background-color: #eee; transition: transform .15s, box-shadow .15s; }
  .ls-swatch-color:hover { transform: scale(1.06); }
  /* Colores en cuadrícula con su nombre debajo, para distinguir tonos parecidos (ej. gris plata / gris oscuro) */
  .ls-swatches:has(.ls-swatch-color) { display: grid; grid-template-columns: repeat(auto-fill, minmax(56px, 1fr)); gap: 12px 4px; }
  .ls-swatch-color { position: relative; justify-self: center; margin-bottom: 28px; }
  .nv-sw-name { position: absolute; top: calc(100% + 5px); left: 50%; transform: translateX(-50%); width: 62px; text-align: center; font-size: 12px; line-height: 1.15; color: var(--nv-muted); pointer-events: none; }
  .ls-swatch-color.active .nv-sw-name { color: var(--nv-ink); font-weight: 700; }
  .ls-swatch-color.active { box-shadow: 0 0 0 2.5px var(--nv-coral); }
  .ls-swatch-size { font-weight: 600; font-size: 14px; padding: 10px 16px; border-radius: 8px; border: 1.5px solid var(--nv-line); background: #fff; color: var(--nv-ink); cursor: pointer; transition: all .15s; }
  .ls-swatch-size.active { border-color: var(--nv-coral); background: var(--nv-blush); }

  .nv-guarantee-mini { display: flex; gap: 12px; align-items: flex-start; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 14px; }
  .nv-guarantee-mini strong { display: block; font-size: 14px; color: #166534; }
  .nv-guarantee-mini p { font-size: 13px; color: var(--nv-ok); line-height: 1.4; }
  .nv-trustline { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px; font-size: 13px; color: var(--nv-muted); }
  .nv-trustline b { color: var(--nv-ok); }

  /* Botón de ReleasIT dentro del formulario */
  /* Puntos donde ReleasIT dibuja su botón (uno arriba y uno en cada sección de pedido) */
  .nv-rsi-slot { width: 100%; }
  .nv-buy-pair { display: flex; gap: 10px; flex-wrap: wrap; }
  .nv-buy-pair .nv-btn { flex: 1 1 200px; min-height: 58px; }
  .nv-btn-add { background: #fff; color: var(--nv-ink); border: 2px solid var(--nv-ink); font-size: 16px; }
  .nv-btn-add:hover { background: var(--nv-blush-2); }
  .nv-btn-buy { flex-direction: column; gap: 0; padding: 10px 18px; background: #2E7D32 !important; box-shadow: 0 8px 20px rgba(46,125,50,.28) !important; }
  .nv-btn-buy:hover { background: #276B2B !important; }
  .nv-btn-buy small { font-size: 12px; font-weight: 600; opacity: .92; }
  .nv-btn[aria-busy="true"] { opacity: .65; pointer-events: none; }
  .nv-final .nv-btn-add { background: transparent; color: #fff; border-color: #fff; }
  .nv-buy-error { margin-top: 8px; color: #b4232f; font-weight: 700; font-size: 14px; text-align: center; }
  .nv-sticky { display: none; }
  @media (max-width: 768px) {
    .nv-sticky { display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 800; gap: 8px; align-items: center; padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px)); background: #fff; border-top: 1px solid var(--nv-line); box-shadow: 0 -6px 18px rgba(0,0,0,.08); transform: translateY(110%); transition: transform .25s ease; }
    .nv-sticky.is-visible { transform: none; }
    .nv-sticky .nv-btn { min-height: 48px; padding: 0 10px; font-size: 15px; }
    .nv-sticky-price { display: flex; flex-direction: column; line-height: 1.15; min-width: 0; font-size: 12px; color: var(--nv-muted); }
    .nv-sticky-price strong { font-size: 17px; color: var(--nv-ink); }
  }
  @media (prefers-reduced-motion: reduce) { .nv-sticky { transition: none; } }
  .nv-final .nv-rsi-slot { max-width: 460px; }

  /* Cifras */
  .nv-stats { background: var(--nv-ink); color: #fff; padding-block: 28px; }
  .nv-stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; text-align: center; }
  .nv-stat b { display: block; font-family: "Young Serif", Georgia, serif; font-size: 30px; color: var(--nv-coral-soft); font-weight: 400; }
  .nv-stat span { font-size: 14px; opacity: .85; }

  /* Carrusel de beneficios (imágenes 4:5 con su propio texto) */
  .nv-promo { padding-block: 28px 8px; }
  .nv-promo-wrap { max-width: 520px; margin-inline: auto; padding-inline: 10px; }
  .nv-promo-stack { display: grid; gap: 14px; }
  .nv-promo-stack img { display: block; width: 100%; height: auto; border-radius: 12px; background: var(--nv-blush); box-shadow: 0 10px 30px rgba(44, 44, 44, .10); }
  @media (min-width: 900px) {
    /* Computador: todas en una fila a lo ancho de la pantalla */
    .nv-promo-wrap { max-width: none; padding-inline: 24px; }
    .nv-promo-stack { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 16px; align-items: start; }
  }
  .nv-promo-viewport { position: relative; overflow: hidden; border-radius: 12px; aspect-ratio: var(--nv-promo-ratio, 0.8); max-width: 100%; background: var(--nv-blush); box-shadow: 0 10px 30px rgba(44, 44, 44, .10); touch-action: pan-y; user-select: none; -webkit-user-select: none; cursor: grab; }
  .nv-promo-viewport.nv-dragging { cursor: grabbing; }
  .nv-promo-track { display: flex; height: 100%; will-change: transform; }
  .nv-promo-track.nv-anim { transition: transform .6s cubic-bezier(.22, .61, .36, 1); }
  .nv-promo-slide { flex: 0 0 100%; height: 100%; }
  .nv-promo-slide img { width: 100%; height: 100%; object-fit: contain; display: block; pointer-events: none; -webkit-user-drag: none; }
  .nv-promo-dots { display: flex; justify-content: center; gap: 2px; margin-top: 10px; }
  .nv-promo-dot { width: 22px; height: 22px; padding: 0; border: 0; background: transparent; cursor: pointer; display: grid; place-items: center; }
  .nv-promo-dot::before { content: ""; width: 7px; height: 7px; border-radius: 50%; border: 1.5px solid var(--nv-coral); background: transparent; transition: background .25s, transform .25s; }
  .nv-promo-dot.active::before { background: var(--nv-coral); transform: scale(1.1); }
  .nv-promo-dot:focus-visible { outline: 2px solid var(--nv-coral); outline-offset: 1px; border-radius: 50%; }
  .nv-promo-arrow { display: none; }
  @media (min-width: 900px) {
    .nv-promo-arrow { display: grid; place-items: center; position: absolute; top: 50%; transform: translateY(-50%); width: 34px; height: 34px; border-radius: 50%; border: 0; background: rgba(255, 255, 255, .85); color: var(--nv-ink); font-size: 18px; cursor: pointer; opacity: 0; transition: opacity .2s; z-index: 2; }
    .nv-promo-viewport:hover .nv-promo-arrow, .nv-promo-arrow:focus-visible { opacity: 1; }
    .nv-promo-prev { left: 10px; }
    .nv-promo-next { right: 10px; }
  }
  @media (prefers-reduced-motion: reduce) { .nv-promo-track.nv-anim { transition: none; } }

  /* Problema */
  .nv-problem-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  .nv-problem-grid.nv-single { grid-template-columns: 1fr; max-width: 720px; margin-inline: auto; }
  .nv-problem-img { width: 100%; border-radius: 18px; display: block; object-fit: cover; aspect-ratio: 4 / 3; }
  .nv-problem-copy { display: grid; gap: 16px; }
  .nv-problem-copy h2 { font-size: clamp(26px, 4vw, 36px); }
  .nv-pains { display: grid; gap: 10px; }
  .nv-pain { display: flex; gap: 12px; align-items: flex-start; }
  .nv-pain i { flex: none; width: 24px; height: 24px; border-radius: 50%; background: #fde2e2; color: var(--nv-cta); display: grid; place-items: center; font-style: normal; font-weight: 800; font-size: 13px; margin-top: 1px; }
  .nv-solution { background: var(--nv-blush); border-radius: 12px; padding: 16px 18px; font-weight: 600; color: var(--nv-ink); }

  /* Qué incluye */
  .nv-kit { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .nv-kit-item { background: #fff; border: 1px solid var(--nv-line); border-radius: 14px; padding: 22px; display: grid; gap: 10px; align-content: start; }
  .nv-kit-item svg { width: 56px; height: 56px; }
  .nv-kit-item h3 { font-size: 20px; }
  .nv-kit-item p { font-size: 15px; }

  /* Pasos */
  .nv-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .nv-step { border-top: 3px solid var(--nv-coral); padding-top: 16px; display: grid; gap: 6px; align-content: start; }
  .nv-step .nv-n { font-family: "Young Serif", Georgia, serif; font-size: 34px; color: var(--nv-coral); line-height: 1; }
  .nv-step h3 { font-size: 19px; }

  /* Guía de medidas */
  .nv-size-table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .nv-size-table th, .nv-size-table td { padding: 14px 16px; text-align: left; border-bottom: 1px solid var(--nv-line); font-variant-numeric: tabular-nums; }
  .nv-size-table th { background: var(--nv-blush); color: var(--nv-ink); font-size: 13px; letter-spacing: .06em; text-transform: uppercase; }
  .nv-size-table tr:last-child td { border-bottom: 0; }
  .nv-size-table tr.nv-sel td { background: #fff8f6; font-weight: 700; color: var(--nv-ink); }
  .nv-size-table tr.nv-sel td:first-child { box-shadow: inset 3px 0 0 var(--nv-coral); }

  /* Colores */
  .nv-marquee-box { overflow: hidden; width: 100%; }
  .nv-marquee { display: flex; width: max-content; gap: 14px; animation: nv-marquee 30s linear infinite; }
  .nv-marquee:hover { animation-play-state: paused; }
  .nv-marquee-item { flex-shrink: 0; width: 230px; height: 230px; border-radius: 14px; overflow: hidden; }
  .nv-marquee-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @keyframes nv-marquee { from { transform: translateX(0); } to { transform: translateX(calc(-50% - 7px)); } }

  /* Videos */
  .nv-videos { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .nv-videos video { width: 100%; display: block; border-radius: 14px; background: #000; }

  /* Reseñas */
  .nv-rev-summary { display: flex; justify-content: center; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 24px; font-weight: 600; color: var(--nv-ink); }
  .nv-reviews { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; align-items: start; }
  .nv-review { background: #fff; border: 1px solid var(--nv-line); border-radius: 14px; padding: 18px; display: grid; gap: 10px; }
  .nv-review-hidden { display: none; }
  .nv-rev-head { display: flex; gap: 10px; align-items: center; }
  .nv-avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; background: var(--nv-coral-soft); color: #fff; display: grid; place-items: center; font-weight: 800; flex: none; }
  .nv-rev-name { font-weight: 700; color: var(--nv-ink); font-size: 15px; }
  .nv-verified { color: var(--nv-ok); font-size: 12px; font-weight: 600; }
  .nv-review-img { width: 100%; height: auto; max-height: 280px; object-fit: cover; border-radius: 10px; cursor: zoom-in; }
  .nv-more { display: block; margin: 24px auto 0; background: #fff; border: 1.5px solid var(--nv-line); color: var(--nv-ink); font: inherit; font-weight: 700; padding: 12px 24px; border-radius: 999px; cursor: pointer; }
  .nv-more:hover { border-color: var(--nv-coral); }
  .nv-swipe-hint { display: none; text-align: center; font-size: 13px; font-weight: 600; color: var(--nv-muted); margin-top: 6px; }

  /* Oferta por cantidad */
  .nv-tiers { display: grid; gap: 14px; max-width: 620px; margin-inline: auto; }
  .nv-tier { position: relative; display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; background: #fff; border: 2px solid var(--nv-line); border-radius: 14px; padding: 18px; cursor: pointer; text-align: left; font: inherit; color: inherit; width: 100%; }
  .nv-tier.active { border-color: var(--nv-coral); background: var(--nv-blush-2); }
  .nv-radio { width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--nv-line); }
  .nv-tier.active .nv-radio { border: 6px solid var(--nv-coral); }
  .nv-tier-name { font-weight: 700; color: var(--nv-ink); display: block; }
  .nv-tier-sub { font-size: 13px; color: var(--nv-muted); }
  .nv-tier-price { text-align: right; font-weight: 800; color: var(--nv-ink); font-variant-numeric: tabular-nums; }
  .nv-tier-price s { display: block; font-weight: 500; font-size: 13px; color: var(--nv-muted); }
  .nv-tag { position: absolute; top: -11px; right: 16px; background: var(--nv-cta); color: #fff; font-size: 12px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; }
  .nv-tag.nv-soft { background: var(--nv-coral); }

  /* Comparativa */
  .nv-table-box { overflow-x: auto; border: 1px solid var(--nv-line); border-radius: 14px; background: #fff; max-width: 820px; margin-inline: auto; }
  .nv-table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .nv-table th, .nv-table td { padding: 14px 16px; text-align: left; border-bottom: 1px solid var(--nv-line); }
  .nv-table th { background: var(--nv-blush); color: var(--nv-ink); font-size: 13px; letter-spacing: .06em; text-transform: uppercase; }
  .nv-table tr:last-child td { border-bottom: 0; }
  .nv-table th:nth-child(2), .nv-table td:nth-child(2) { background: #fff8f6; text-align: center; }
  .nv-table th:nth-child(3), .nv-table td:nth-child(3) { text-align: center; }
  .nv-yes { color: var(--nv-ok); font-weight: 800; }
  .nv-no { color: #c24; font-weight: 800; }

  /* Garantía */
  .nv-guarantee { background: var(--nv-coral); color: #fff; border-radius: 22px; padding: 40px 28px; display: grid; grid-template-columns: auto 1fr; gap: 28px; align-items: center; }
  .nv-guarantee h2 { color: #fff; font-size: clamp(26px, 4vw, 34px); }
  .nv-guarantee p { margin-top: 8px; max-width: 60ch; }
  .nv-seal { width: 120px; height: 120px; border-radius: 50%; border: 3px dashed rgba(255,255,255,.85); display: grid; place-items: center; text-align: center; font-weight: 800; font-size: 13px; line-height: 1.2; }

  /* FAQ */
  .nv-faq { max-width: 760px; margin-inline: auto; display: grid; gap: 10px; }
  .nv-faq details { background: #fff; border: 1px solid var(--nv-line); border-radius: 12px; padding: 0 18px; }
  .nv-faq summary { cursor: pointer; list-style: none; padding: 16px 0; font-weight: 700; color: var(--nv-ink); display: flex; justify-content: space-between; gap: 12px; }
  .nv-faq summary::-webkit-details-marker { display: none; }
  .nv-faq summary::after { content: "+"; color: var(--nv-coral); font-size: 22px; line-height: 1; }
  .nv-faq details[open] summary::after { content: "–"; }
  .nv-faq details p { padding-bottom: 16px; }

  /* Transportadoras */
  .nv-carriers { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 28px; }
  .nv-carriers img { max-height: 38px; width: auto; object-fit: contain; }

  /* Cierre */
  .nv-final { background: var(--nv-ink); color: #fff; text-align: center; }
  .nv-final h2 { color: #fff; font-size: clamp(28px, 4.5vw, 42px); }
  .nv-final-inner { display: grid; gap: 16px; justify-items: center; max-width: 620px; margin-inline: auto; }
  .nv-final p { opacity: .85; }
  .nv-final .nv-stock { color: var(--nv-coral-soft); font-weight: 700; opacity: 1; }
  .nv-final .nv-trustline { color: rgba(255,255,255,.75); }
  .nv-final .nv-trustline b { color: #7ee2a0; }

  /* Lightbox reseñas */
  .nv-lightbox { position: fixed; inset: 0; z-index: 100000; background: rgba(0,0,0,.9); display: none; align-items: center; justify-content: center; padding: 20px; }
  .nv-lightbox.open { display: flex; }
  .nv-lightbox img { max-width: 92%; max-height: 85vh; border-radius: 8px; }
  .nv-lightbox button { position: absolute; top: 12px; right: 18px; background: none; border: 0; color: #fff; font-size: 40px; cursor: pointer; }

  @media (max-width: 900px) {
    .nv-reviews { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 860px) {
    .nv-hero-grid, .nv-problem-grid { grid-template-columns: 1fr; gap: 24px; }
    .nv-gallery-col { position: static; }
  }
  @media (max-width: 600px) {
    /* Celular: foto más baja para que el nombre, las estrellas y el precio se vean sin bajar */
    .nv-hero { padding-block: 12px 36px; }
    .nv-hero-grid { gap: 14px; }
    .ls-gallery { aspect-ratio: 1 / 1; }
    .ls-thumb-wrapper { width: 58px; height: 58px; }
    .nv-buy { gap: 14px; }
    .nv-hero h1 { font-size: 25px; }
    .nv-price { font-size: 30px; }
  }
  @media (max-width: 760px) {
    .nv-kit, .nv-steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    /* Espacio para el botón fijo de ReleasIT: al final del footer, no entre la página y el footer */
    body:has(.nv-page) footer { padding-bottom: 100px; }
    .nv-marquee-item { width: 160px; height: 160px; }
  }
  @media (max-width: 600px) {
    /* Tablas completas en celular, sin deslizar hacia la derecha */
    .nv-table-box { overflow-x: visible; }
    .nv-table, .nv-size-table { font-size: 13px; table-layout: fixed; }
    .nv-table th, .nv-table td, .nv-size-table th, .nv-size-table td { padding: 10px 8px; overflow-wrap: anywhere; }
    .nv-table th, .nv-size-table th { font-size: 12px; letter-spacing: .02em; }
    .nv-table th:first-child, .nv-table td:first-child { width: 56%; }
    .nv-table th:nth-child(2), .nv-table td:nth-child(2) { width: 24%; }
    .nv-table th:nth-child(3), .nv-table td:nth-child(3) { width: 20%; }
    .nv-size-table th:first-child, .nv-size-table td:first-child { width: 26%; }
    .nv-size-table th:nth-child(2), .nv-size-table td:nth-child(2) { width: 32%; }
    .nv-size-table th:nth-child(3), .nv-size-table td:nth-child(3) { width: 18%; }
    .nv-size-table th:nth-child(4), .nv-size-table td:nth-child(4) { width: 24%; }
    /* Cifras en una fila */
    .nv-stats { padding-block: 20px; }
    .nv-stats-grid { gap: 8px; }
    .nv-stat b { font-size: 21px; }
    .nv-stat span { display: block; font-size: 12px; line-height: 1.3; margin-top: 2px; }
    /* Qué incluye: icono al lado del texto */
    .nv-kit { gap: 10px; }
    .nv-kit-item { grid-template-columns: 44px 1fr; column-gap: 14px; row-gap: 4px; padding: 16px; }
    .nv-kit-item svg { width: 44px; height: 44px; grid-row: span 2; }
    .nv-kit-item h3 { font-size: 18px; }
    /* Pasos: número al lado */
    .nv-steps { gap: 16px; }
    .nv-step { grid-template-columns: 36px 1fr; column-gap: 12px; row-gap: 2px; padding-top: 12px; }
    .nv-step .nv-n { grid-row: span 2; font-size: 28px; }
    /* Reseñas: carrusel deslizable en vez de una columna larguísima */
    .nv-reviews { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin-inline: -16px; padding: 4px 16px 14px; scrollbar-width: none; }
    .nv-reviews::-webkit-scrollbar { display: none; }
    .nv-review, .nv-review.nv-review-hidden { display: grid; flex: 0 0 84%; scroll-snap-align: center; align-content: start; }
    .nv-review-img { max-height: 220px; }
    .nv-more { display: none; }
    .nv-swipe-hint { display: block; }
    /* Videos lado a lado */
    .nv-videos { grid-template-columns: 1fr 1fr; gap: 10px; }
    .nv-videos video { max-height: 380px; object-fit: cover; }
    /* Fondo un poco más suave detrás del texto */
    .nv-bg-tile { opacity: .10; }
    .nv-guarantee { grid-template-columns: 1fr; text-align: center; justify-items: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nv-page *, .nv-marquee { animation: none !important; transition: none !important; }
  }
</style>

{% assign current_variant = product.selected_or_first_available_variant %}
{%- comment -%}
  Precio inicial: siempre el más bajo disponible (ej. Sencilla $79.900), como en los anuncios,
  aunque el enlace traiga ?variant= de otro tamaño. Cambia cuando el cliente elige.
{%- endcomment -%}
{%- for v in product.variants -%}
  {%- if v.available and v.price == product.price_min -%}{%- assign current_variant = v -%}{%- break -%}{%- endif -%}
{%- endfor -%}
{% assign s = section.settings %}

<div class="nv-page" id="product-section-{{ section.id }}">

  {% comment %} Fondo animado: usa las mismas imágenes del "Carrusel de colores" (portadas). {% endcomment %}
  {% if s.show_bg_covers %}
    {% assign nv_bg_urls = '' %}
    {% for i in (1..15) %}
      {% assign ck = 'color_image_' | append: i %}
      {% if s[ck] != blank %}
        {% assign nv_url = s[ck] | image_url: width: 400 %}
        {% assign nv_bg_urls = nv_bg_urls | append: nv_url | append: '|' %}
      {% endif %}
    {% endfor %}
    {% assign nv_bg_list = nv_bg_urls | split: '|' %}
    {% if nv_bg_list.size > 0 %}
      <div class="nv-bg" aria-hidden="true">
        <div class="nv-bg-mosaic">
          {% for n in (0..47) %}
            {% assign nv_i = n | modulo: 24 | modulo: nv_bg_list.size %}
            <div class="nv-bg-tile" style="background-image: url('{{ nv_bg_list[nv_i] }}');"></div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% endif %}

  <!-- HERO -->
  <section class="nv-hero">
    <div class="nv-wrap nv-hero-grid">
      <div class="nv-gallery-col">
        <div class="ls-gallery" id="ls-main-gallery">
          {% if current_variant.compare_at_price > current_variant.price %}
            {% assign nv_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price %}
            <span class="nv-badge-float nv-r" id="nv-badge-float">-{{ nv_pct }}%</span>
          {% endif %}
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              {% assign ls_media_filename = media.preview_image.src | split: '/' | last | split: '?' | first | downcase %}
              <div class="ls-media-item" data-media-id="{{ media.id }}" data-color="{{ media.alt | escape }}" data-filename="{{ ls_media_filename | escape }}" {% unless forloop.first %}style="display: none;"{% endunless %}>
                {% case media.media_type %}
                  {% when 'video' %}
                    {{ media | video_tag: controls: true, autoplay: true, loop: true, muted: true }}
                  {% when 'external_video' %}
                    {{ media | external_video_tag }}
                  {% else %}
                    <img src="{{ media | image_url: width: 900 }}" alt="{{ media.alt | default: product.title | escape }}" width="900" height="900" {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
                {% endcase %}
              </div>
            {% endfor %}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="ls-thumbnails">
            {% for media in product.media %}
              {% assign ls_media_filename = media.preview_image.src | split: '/' | last | split: '?' | first | downcase %}
              <div class="ls-thumb-wrapper {% if forloop.first %}active{% endif %}" data-media-id="{{ media.id }}" data-color="{{ media.alt | escape }}" data-filename="{{ ls_media_filename | escape }}" onclick="changeLsMedia(this, '{{ media.id }}')">
                <img src="{{ media.preview_image | image_url: width: 150 }}" alt="{{ media.alt | default: product.title | escape }}" width="74" height="74" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="nv-buy">
        <div class="nv-rating"><span class="nv-stars">★★★★★</span> {% if s.review_1_name != blank %}<a href="#nv-resenas">{{ s.rating_text }}</a>{% else %}{{ s.rating_text }}{% endif %}</div>
        {%- if s.title_source == 'headline' -%}
          <h1>{{ s.headline | default: product.title }}</h1>
        {%- else -%}
          <h1>{{ product.title }}</h1>
        {%- endif -%}

        <div class="nv-price-block">
        <div class="nv-price-row">
          <span class="nv-price" id="ls-price">{{ current_variant.price | money_without_trailing_zeros }}</span>
          <span class="nv-compare" id="ls-compare" {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>{{ current_variant.compare_at_price | money_without_trailing_zeros }}</span>
          <span class="nv-save" id="ls-badge" {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>
            {% if current_variant.compare_at_price > current_variant.price %}Ahorras {{ current_variant.compare_at_price | minus: current_variant.price | money_without_trailing_zeros }}{% endif %}
          </span>
        </div>
        {%- if s.perks != blank -%}
          {%- assign nv_perks = s.perks | split: '|' -%}
          <div class="nv-perks">
            {%- for perk in nv_perks -%}
              {%- assign perk_txt = perk | strip -%}
              {%- if perk_txt != blank -%}
                <span class="nv-perk"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4 10-10"/></svg>{{ perk_txt }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        </div>

        {% if s.title_source == 'headline' %}
          {% if s.subheadline != blank %}<p class="nv-lead">{{ s.subheadline }}</p>{% endif %}
        {% elsif s.headline != blank %}
          <p class="nv-lead">{{ s.headline }}</p>
        {% endif %}

        <div class="nv-pills">
          {% for i in (1..6) %}
            {% assign pill_key = 'pill_' | append: i %}
            {% if s[pill_key] != blank %}<span class="nv-pill">✔ {{ s[pill_key] }}</span>{% endif %}
          {% endfor %}
        </div>

        <div id="nv-comprar">
          {% form 'product', product, id: 'landing-product-form', class: 'ls-form releasit-form' %}
            <input type="hidden" name="id" id="ls-variant-id" value="{{ current_variant.id }}">
            <input type="hidden" name="quantity" id="ls-quantity" value="1">

            {% unless product.has_only_default_variant %}
              {% for option in product.options_with_values %}
                {% assign option_name_downcase = option.name | downcase %}
                <div class="ls-variant-group">
                  <label class="ls-variant-label">{{ option.name }}: <span id="ls-val-{{ option.position }}">Selecciona una opción</span></label>
                  <div class="ls-swatches">
                    {% for value in option.values %}
                      {% if option_name_downcase contains 'color' or option_name_downcase contains 'colour' %}
                        {% assign variant_img = '' %}
                        {% for v in product.variants %}
                          {% if v.options contains value and v.featured_image %}
                            {% assign variant_img = v.featured_image | image_url: width: 120 %}
                            {% break %}
                          {% endif %}
                        {% endfor %}
                        <div class="ls-swatch-color" role="button" tabindex="0"
                             data-option-index="{{ option.position }}"
                             data-value="{{ value | escape }}"
                             onclick="selectLsVariant(this)"
                             onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();selectLsVariant(this);}"
                             {% if variant_img != '' %}
                             style="background-image: url('{{ variant_img }}'); background-size: cover; background-position: center;"
                             {% endif %}
                             title="{{ value }}" aria-label="{{ value }}"><span class="nv-sw-name">{{ value }}</span></div>
                      {% else %}
                        <div class="ls-swatch-size" role="button" tabindex="0"
                             data-option-index="{{ option.position }}"
                             data-value="{{ value | escape }}"
                             onclick="selectLsVariant(this)"
                             onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();selectLsVariant(this);}">{{ value }}</div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            {% endunless %}


            {%- if s.show_bundles and s.bundles_in_hero -%}
              {% comment %} Oferta por cantidad junto a las opciones: el cliente la ve antes del botón. {% endcomment %}
              <div class="nv-tiers-hero">
                <span class="nv-qty-label">Cantidad</span>
                <div class="nv-tiers" id="nv-tiers" data-rsi-offer="{{ s.rsi_offer_name | escape }}">
          {% for q in (1..3) %}
            {% assign dk = 'bundle_' | append: q | append: '_discount' %}
            {% assign lk = 'bundle_' | append: q | append: '_label' %}
            <button type="button" class="nv-tier {% if q == 1 %}active{% endif %}" data-qty="{{ q }}" data-pct="{{ s[dk] | default: 0 }}" data-fixed="0" data-compare="1" onclick="nvSelectTier(this)">
              {% if q == 2 and s[dk] > 0 %}<span class="nv-tag">Más popular</span>{% endif %}
              {% if q == 3 and s[dk] > 0 %}<span class="nv-tag nv-soft">Mayor ahorro</span>{% endif %}
              <span class="nv-radio"></span>
              <span>
                <span class="nv-tier-name">{{ q }} {% if q == 1 %}{{ s.bundle_unit_singular }}{% else %}{{ s.bundle_unit_plural }}{% endif %}</span>
                <span class="nv-tier-sub">{{ s[lk] }}{% if s[dk] > 0 %} · {{ s[dk] }}% OFF{% endif %}</span>
              </span>
              <span class="nv-tier-price"><span class="nv-tier-now">—</span><s class="nv-tier-was"></s></span>
            </button>
          {% endfor %}
                </div>
              </div>
            {%- endif -%}

            {% comment %} ReleasIT dibuja su botón en cada elemento #rsi-button-hook de la página. {% endcomment %}
            <div class="nv-rsi-slot"><div id="rsi-button-hook" class="_rsi-buy-now-button-app-block-hook"></div></div>
          {% endform %}
        </div>

        {% if s.guarantee_title != blank %}
          <div class="nv-guarantee-mini">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#22c55e" stroke-width="2" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"></path><path d="M9 12l2 2 4-4"></path></svg>
            <div><strong>{{ s.guarantee_title }}</strong><p>{{ s.guarantee_text }}</p></div>
          </div>
        {% endif %}

        {% if s.include_1_title != blank %}
          <a class="nv-btn nv-btn-ghost nv-btn-block" href="#nv-incluye">↓ Ver qué incluye</a>
        {% endif %}

        <div class="nv-trustline">
          <span><b>✔</b> Pago contra entrega</span>
          <span><b>✔</b> {{ s.shipping_time }}</span>
          <span><b>✔</b> Compra 100% segura</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CIFRAS -->
  {% if s.stat_1_value != blank %}
    <div class="nv-stats">
      <div class="nv-wrap nv-stats-grid">
        {% for i in (1..3) %}
          {% assign sv = 'stat_' | append: i | append: '_value' %}
          {% assign sl = 'stat_' | append: i | append: '_label' %}
          {% if s[sv] != blank %}<div class="nv-stat"><b>{{ s[sv] }}</b><span>{{ s[sl] }}</span></div>{% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <!-- CARRUSEL DE BENEFICIOS -->
  {% assign nv_promo_count = 0 %}
  {% assign nv_promo_first = nil %}
  {% for i in (1..4) %}
    {% assign pk = 'promo_image_' | append: i %}
    {% if s[pk] != blank %}
      {% assign nv_promo_count = nv_promo_count | plus: 1 %}
      {% if nv_promo_first == nil %}{% assign nv_promo_first = s[pk] %}{% endif %}
    {% endif %}
  {% endfor %}
  {% if s.show_promo and nv_promo_count > 0 %}
    <section class="nv-promo" aria-label="Beneficios de las sábanas">
      <div class="nv-promo-wrap">
        {% comment %} Las imágenes van una debajo de la otra (antes era un carrusel). {% endcomment %}
        <div class="nv-promo-stack">
          {% assign nv_promo_n = 0 %}
          {% for i in (1..4) %}
            {% assign pk = 'promo_image_' | append: i %}
            {% assign ak = 'promo_alt_' | append: i %}
            {% if s[pk] != blank %}
              {% assign nv_promo_n = nv_promo_n | plus: 1 %}
              <img
                src="{{ s[pk] | image_url: width: 1080 }}"
                srcset="{{ s[pk] | image_url: width: 540 }} 540w, {{ s[pk] | image_url: width: 720 }} 720w, {{ s[pk] | image_url: width: 1080 }} 1080w"
                sizes="(max-width: 899px) min(500px, calc(100vw - 20px)), 25vw"
                alt="{{ s[ak] | default: s[pk].alt | escape }}"
                width="{{ s[pk].width }}" height="{{ s[pk].height }}"
                {% if nv_promo_n == 1 %}loading="eager"{% else %}loading="lazy" decoding="async"{% endif %}>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  <!-- EL PROBLEMA -->
  {% if s.problem_title != blank %}
    <section class="nv-sec">
      <div class="nv-wrap nv-problem-grid {% if s.problem_image == blank %}nv-single{% endif %}">
        {% if s.problem_image != blank %}
          <img class="nv-problem-img" src="{{ s.problem_image | image_url: width: 900 }}" alt="{{ s.problem_title | escape }}" width="900" height="675" loading="lazy">
        {% endif %}
        <div class="nv-problem-copy">
          <span class="nv-eyebrow">El problema real</span>
          <h2>{{ s.problem_title }}</h2>
          <div class="nv-pains">
            {% for i in (1..4) %}
              {% assign pk = 'pain_' | append: i %}
              {% if s[pk] != blank %}<div class="nv-pain"><i>✕</i><p>{{ s[pk] }}</p></div>{% endif %}
            {% endfor %}
          </div>
          {% if s.solution_text != blank %}<p class="nv-solution">{{ s.solution_text }}</p>{% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  <!-- QUÉ INCLUYE -->
  {% if s.include_1_title != blank %}
    <section class="nv-sec nv-alt" id="nv-incluye">
      <div class="nv-wrap">
        <div class="nv-head">
          <span class="nv-eyebrow">{{ s.include_eyebrow | default: 'Qué incluye' }}</span>
          <h2>{{ s.include_title }}</h2>
          {% if s.include_subtitle != blank %}<p>{{ s.include_subtitle }}</p>{% endif %}
        </div>
        <div class="nv-kit">
          {% for i in (1..3) %}
            {% assign it = 'include_' | append: i | append: '_title' %}
            {% assign ix = 'include_' | append: i | append: '_text' %}
            {% if s[it] != blank %}
              <div class="nv-kit-item">
                {% case i %}
                  {% when 1 %}<svg viewBox="0 0 56 56" aria-hidden="true"><rect x="6" y="14" width="44" height="28" rx="6" fill="#F4A99C"/><path d="M6 20 Q6 14 12 14 M50 20 Q50 14 44 14 M6 36 Q6 42 12 42 M50 36 Q50 42 44 42" stroke="#E8746A" stroke-width="3" fill="none"/></svg>
                  {% when 2 %}<svg viewBox="0 0 56 56" aria-hidden="true"><rect x="8" y="10" width="40" height="36" rx="4" fill="#FCEFEC" stroke="#E8746A" stroke-width="2"/><rect x="8" y="10" width="40" height="8" rx="3" fill="#E8746A"/></svg>
                  {% else %}<svg viewBox="0 0 56 56" aria-hidden="true"><rect x="6" y="18" width="30" height="20" rx="9" fill="#F4A99C"/><rect x="20" y="22" width="30" height="20" rx="9" fill="#E8746A"/></svg>
                {% endcase %}
                <h3>{{ s[it] }}</h3>
                <p>{{ s[ix] }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
