          {% for round in (1..2) %}
            {% for i in (1..15) %}
              {% assign ck = 'color_image_' | append: i %}
              {% if s[ck] != blank %}
                <div class="nv-marquee-item" {% if round == 2 %}aria-hidden="true"{% endif %}>
                  <img src="{{ s[ck] | image_url: width: 500 }}" alt="Color disponible" width="230" height="230" loading="lazy">
