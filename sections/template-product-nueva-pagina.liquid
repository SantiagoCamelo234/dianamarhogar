          {% if s.steps_subtitle != blank %}<p>{{ s.steps_subtitle }}</p>{% endif %}
        </div>
        <div class="nv-steps">
          {% for i in (1..3) %}
            {% assign st = 'step_' | append: i | append: '_title' %}
            {% assign sx = 'step_' | append: i | append: '_text' %}
            {% if s[st] != blank %}
              <div class="nv-step"><span class="nv-n">{{ i }}</span><h3>{{ s[st] }}</h3><p>{{ s[sx] }}</p></div>
            {% endif %}
          {% endfor %}
        </div>
