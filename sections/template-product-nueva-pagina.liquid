              <span>
                <span class="nv-tier-name">{{ q }} {% if q == 1 %}{{ s.bundle_unit_singular }}{% else %}{{ s.bundle_unit_plural }}{% endif %}</span>
                <span class="nv-tier-sub">{{ s[lk] }}{% if s[dk] > 0 %} · {{ s[dk] }}% OFF{% endif %}</span>
              </span>
