</div>

{% assign ls_color_option_index = 0 %}
{% for option in product.options_with_values %}
  {% assign ls_opt_name_dc = option.name | downcase %}
  {% if ls_opt_name_dc contains 'color' or ls_opt_name_dc contains 'colour' %}
    {% assign ls_color_option_index = option.position %}
  {% endif %}
{% endfor %}

<script>
  var lsProductJson = {{ product | json }};
  var nvMoneyFormat = {{ shop.money_format | json }};

  var lsVariantPrices = {
    {% for variant in product.variants %}
      "{{ variant.id }}": {
        "price": {{ variant.price | money_without_trailing_zeros | json }},
        "compare_at_price": {{ variant.compare_at_price | money_without_trailing_zeros | json }},
        "save": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | money_without_trailing_zeros | json }}{% else %}""{% endif %},
        "has_discount": {% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %},
        "discount_pct": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round }}{% else %}0{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  var lsGalleryData = {
    colorOptionIndex: {{ ls_color_option_index }},
    featuredMediaPairs: [
      {% if ls_color_option_index > 0 %}
        {% assign ls_color_zero_index = ls_color_option_index | minus: 1 %}
        {% for variant in product.variants %}
          {% if variant.featured_media %}
            [{{ variant.featured_media.id }}, {{ variant.options[ls_color_zero_index] | json }}]{% unless forloop.last %},{% endunless %}
          {% endif %}
        {% endfor %}
      {% endif %}
    ]
  };

  /* ---------- Galería filtrada por color (misma lógica que la plantilla actual) ----------
     Las fotos se filtran por su "Alt text" en el admin (nombre del color en minúsculas,
     ej. "gris plata"). Si ninguna coincide, se muestran todas. */
  var lsCombiningMarksRegex = new RegExp('[' + String.fromCharCode(768) + '-' + String.fromCharCode(879) + ']', 'g');
  function lsNormalizeColor(str) {
    return (str || '').toString().trim().toLowerCase().normalize('NFD').replace(lsCombiningMarksRegex, '');
  }

  var lsFeaturedMediaByColor = (function () {
    var map = {};
    (lsGalleryData.featuredMediaPairs || []).forEach(function (pair) {
      var color = lsNormalizeColor(pair[1]);
      if (!map[color]) map[color] = [];
      if (map[color].indexOf(pair[0]) === -1) map[color].push(pair[0]);
    });
    return map;
  })();

  function lsVisibleMediaIdsForColor(colorValue) {
    var targetColor = lsNormalizeColor(colorValue);
    if (!targetColor) return null;
    var matchingIds = [];
    document.querySelectorAll('#ls-main-gallery .ls-media-item[data-media-id]').forEach(function (item) {
      if (lsNormalizeColor(item.getAttribute('data-color')) === targetColor) {
        matchingIds.push(parseInt(item.getAttribute('data-media-id'), 10));
      }
    });
    (lsFeaturedMediaByColor[targetColor] || []).forEach(function (mediaId) {
      if (matchingIds.indexOf(mediaId) === -1) matchingIds.push(mediaId);
    });
    return matchingIds.length ? matchingIds : null;
  }

  var lsIsInitialGalleryLoad = true;
  function applyLsGalleryVariantFilter(colorValue) {
    var visibleIds = lsVisibleMediaIdsForColor(colorValue);
    var mediaItems = document.querySelectorAll('#ls-main-gallery .ls-media-item');
    var thumbs = document.querySelectorAll('.ls-thumb-wrapper');

    if (lsIsInitialGalleryLoad) {
      var portadaIds = [];
      mediaItems.forEach(function (item) {
        var id = parseInt(item.getAttribute('data-media-id'), 10);
        var visibleForColor = !visibleIds || visibleIds.indexOf(id) !== -1;
        if (visibleForColor && (item.getAttribute('data-filename') || '').indexOf('portada') !== -1) portadaIds.push(id);
      });
      if (portadaIds.length > 0) visibleIds = portadaIds;
      lsIsInitialGalleryLoad = false;
    }

    var firstVisibleId = null;
    mediaItems.forEach(function (item) {
      var id = parseInt(item.getAttribute('data-media-id'), 10);
      var visible = !visibleIds || visibleIds.indexOf(id) !== -1;
      item.classList.toggle('ls-media-variant-hidden', !visible);
      if (visible && firstVisibleId === null) firstVisibleId = id;
    });
    thumbs.forEach(function (thumb) {
      var id = parseInt(thumb.getAttribute('data-media-id'), 10);
      thumb.classList.toggle('ls-thumb-variant-hidden', !(!visibleIds || visibleIds.indexOf(id) !== -1));
    });

    var activeVisible = false;
    mediaItems.forEach(function (item) {
      if (item.style.display !== 'none' && !item.classList.contains('ls-media-variant-hidden')) activeVisible = true;
    });
    if (!activeVisible && firstVisibleId !== null) {
      changeLsMedia(document.querySelector('.ls-thumb-wrapper[data-media-id="' + firstVisibleId + '"]'), firstVisibleId);
    }
  }

  function changeLsMedia(thumb, mediaId) {
    document.querySelectorAll('.ls-media-item').forEach(function (el) {
      el.style.display = 'none';
      var v = el.querySelector('video'); if (v) v.pause();
    });
    var active = document.querySelector('.ls-media-item[data-media-id="' + mediaId + '"]');
    if (active) {
      active.style.display = 'block';
      var v = active.querySelector('video'); if (v) v.play();
    }
    document.querySelectorAll('.ls-thumb-wrapper').forEach(function (el) { el.classList.remove('active'); });
    if (thumb) thumb.classList.add('active');
  }

  /* ---------- Selección de variante ---------- */
  function selectLsVariant(swatch) {
    var optionIndex = parseInt(swatch.getAttribute('data-option-index'), 10);
    var value = swatch.getAttribute('data-value');
    var group = swatch.closest('.ls-variant-group');
    group.querySelectorAll('.ls-swatch-color, .ls-swatch-size').forEach(function (el) { el.classList.remove('active'); });
    swatch.classList.add('active');
    group.classList.remove('nv-missing');
    document.getElementById('ls-val-' + optionIndex).textContent = value;

    updateAvailableOptions(optionIndex, value);
    if (lsGalleryData.colorOptionIndex > 0 && optionIndex === lsGalleryData.colorOptionIndex) {
      applyLsGalleryVariantFilter(value);
    }
    if (swatch.classList.contains('ls-swatch-size')) nvHighlightSizeRow(value);
    if (typeof nvMissingGroups === 'function' && !nvMissingGroups().length) nvHideChooseMsg();
    updateLsVariant();
  }

  // Marca en la guía de medidas la fila del tamaño elegido.
  function nvHighlightSizeRow(value) {
    var target = lsNormalizeColor(value);
    document.querySelectorAll('.nv-size-table tr[data-size]').forEach(function (row) {
      row.classList.toggle('nv-sel', lsNormalizeColor(row.getAttribute('data-size')) === target);
    });
  }

  function updateAvailableOptions(changedOptionIndex, changedValue) {
    var availableVariants = lsProductJson.variants.filter(function (v) {
      return v.options[changedOptionIndex - 1] === changedValue;
    });
    document.querySelectorAll('.ls-variant-group').forEach(function (group) {
      var swatches = group.querySelectorAll('.ls-swatch-color, .ls-swatch-size');
      if (!swatches.length) return;
      var idx = parseInt(swatches[0].getAttribute('data-option-index'), 10);
      if (idx === changedOptionIndex) return;
      var possible = availableVariants.map(function (v) { return v.options[idx - 1]; });
      swatches.forEach(function (sw) {
        if (possible.indexOf(sw.getAttribute('data-value')) !== -1) {
          sw.style.display = '';
        } else {
          sw.style.display = 'none';
          if (sw.classList.contains('active')) {
            sw.classList.remove('active');
            document.getElementById('ls-val-' + idx).textContent = 'Selecciona una opción';
          }
        }
      });
    });
  }

  function lsSelectedOptions() {
    var selected = [];
    document.querySelectorAll('.ls-variant-group').forEach(function (group) {
      var a = group.querySelector('.ls-swatch-color.active, .ls-swatch-size.active');
      if (a) selected[parseInt(a.getAttribute('data-option-index'), 10) - 1] = a.getAttribute('data-value');
    });
    return selected;
  }

  // Si el enlace trae ?variant= y el cliente aún no eligió nada, se cambia por la variante del
  // precio inicial: así ReleasIT no abre el formulario con otro tamaño.
  (function nvResetUrlVariant() {
    var url = new URL(window.location.href);
    if (!url.searchParams.has('variant')) return;
    if (document.querySelector('.ls-swatch-size.active, .ls-swatch-color.active')) return;
    url.searchParams.set('variant', document.getElementById('ls-variant-id').value);
    window.history.replaceState({}, '', url.toString());
  })();

  function nvCurrentVariant() {
    var id = parseInt(document.getElementById('ls-variant-id').value, 10);
    return lsProductJson.variants.find(function (v) { return v.id === id; });
  }

  function updateLsVariant() {
    var selected = lsSelectedOptions();
    var match = lsProductJson.variants.find(function (variant) {
      return variant.options.every(function (opt, i) { return selected[i] === undefined || opt === selected[i]; });
    });
    if (!match) return;

    var idInput = document.getElementById('ls-variant-id');
    idInput.value = match.id;
    idInput.dispatchEvent(new Event('change', { bubbles: true }));

    // ReleasIT lee la variante desde ?variant= en la URL; sin esto usa la variante por defecto.
    var url = new URL(window.location.href);
    url.searchParams.set('variant', match.id);
    window.history.replaceState({}, '', url.toString());

    var d = lsVariantPrices[match.id];
    if (d) {
      document.getElementById('ls-price').innerHTML = d.price;
      var cmp = document.getElementById('ls-compare');
      var badge = document.getElementById('ls-badge');
      var floatBadge = document.getElementById('nv-badge-float');
      if (d.has_discount) {
        cmp.innerHTML = d.compare_at_price; cmp.style.display = '';
        badge.innerHTML = 'Ahorras ' + d.save; badge.style.display = '';
        if (floatBadge) { floatBadge.textContent = '-' + d.discount_pct + '%'; floatBadge.style.display = ''; }
      } else {
        cmp.style.display = 'none';
        badge.style.display = 'none';
        if (floatBadge) floatBadge.style.display = 'none';
      }
    }

    if (lsGalleryData.colorOptionIndex > 0) {
      applyLsGalleryVariantFilter(match.options[lsGalleryData.colorOptionIndex - 1]);
    }
    nvRenderTiers();
  }

  /* ---------- Oferta por cantidad ---------- */
  function nvFormatMoney(cents) {
    var n = Math.round(cents);
    var fmt = nvMoneyFormat || '{% raw %}${{amount_no_decimals_with_comma_separator}}{% endraw %}';
    var m = fmt.match(/\{\{\s*(\w+)\s*\}\}/);
    var key = m ? m[1] : 'amount_no_decimals_with_comma_separator';
    function delim(num, precision, thousands, decimal) {
      var parts = (num / 100).toFixed(precision).split('.');
      return parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands) + (parts[1] ? decimal + parts[1] : '');
    }
    var value;
    switch (key) {
      case 'amount': value = delim(n, 2, ',', '.'); break;
      case 'amount_no_decimals': value = delim(n, 0, ',', '.'); break;
      case 'amount_with_comma_separator': value = delim(n, 2, '.', ','); break;
      default: value = delim(n, 0, '.', ',');
    }
    return fmt.replace(/\{\{\s*\w+\s*\}\}/, value.replace(/[.,]00$/, ''));
  }

  /* ---------- Oferta por cantidad conectada a ReleasIT ----------
     ReleasIT publica sus ofertas en window._RSI_COD_FORM_QUANTIY_OFFERS. Se usa la
     oferta activa de este producto (o la que tenga el nombre configurado, ej. "2 25").
     Descuento en porcentaje: ds.v / 10000 (1000 = 10 %). Descuento fijo: ds.v en centavos.
     Así los precios de la página son los mismos que cobra el formulario de ReleasIT. */
  function nvRsiOffer() {
    var list = window._RSI_COD_FORM_QUANTIY_OFFERS;
    if (!Array.isArray(list)) return null;
    var pid = String(lsProductJson.id);
    var wanted = (document.getElementById('nv-tiers') || {}).getAttribute ? document.getElementById('nv-tiers').getAttribute('data-rsi-offer') : '';
    var active = list.filter(function (o) { return o && o.isActive && o.type === 'quantity-offer' && Array.isArray(o.offers) && o.offers.length; });
    var forProduct = active.filter(function (o) { return !o.pIds || o.pIds === 'all' || (Array.isArray(o.pIds) && (o.pIds.indexOf(pid) !== -1 || o.pIds.indexOf('all') !== -1)); });
    var byName = wanted ? forProduct.filter(function (o) { return (o.name || '').trim() === wanted.trim(); }) : [];
    return byName[0] || forProduct[0] || null;
  }

  function nvEscape(str) {
    return String(str == null ? '' : str).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; });
  }

  function nvBuildTiersFromRsi() {
    var offer = nvRsiOffer();
    var box = document.getElementById('nv-tiers');
    if (!offer || !box) return;
    box.querySelectorAll('.nv-tier').forEach(function (t) { t.remove(); });
    var slot = box.querySelector('.nv-rsi-slot');
    var items = offer.offers.slice().sort(function (x, y) { return (x.pos || 0) - (y.pos || 0); });
    var preselected = items.findIndex(function (o) { return o.pres; });
    if (preselected < 0) preselected = 0;
    items.forEach(function (o, i) {
      var ds = o.ds || {};
      var pct = ds.t === 'percentage' ? Math.max(0, Math.min(100, (ds.v || 0) / 100)) : 0;
      var fixed = ds.t === 'percentage' || ds.t === 'none' || !ds.t ? 0 : (ds.v || 0);
      var tag = o.bestDealBadge && o.bestDealBadge.show ? o.bestDealBadge.badgeContent : (o.plaque || '');
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'nv-tier' + (i === preselected ? ' active' : '');
      btn.setAttribute('data-qty', o.qty || 1);
      btn.setAttribute('data-pct', pct);
      btn.setAttribute('data-fixed', fixed);
      btn.setAttribute('data-compare', offer.useComparePrice ? '1' : '0');
      btn.setAttribute('data-title', o.title || '');
      btn.setAttribute('data-first', i === 0 ? '1' : '0');
      btn.onclick = function () { nvSelectTier(btn); };
      btn.innerHTML =
        (tag ? '<span class="nv-tag' + (o.bestDealBadge && o.bestDealBadge.show ? '' : ' nv-soft') + '">' + nvEscape(tag) + '</span>' : '') +
        '<span class="nv-radio"></span><span><span class="nv-tier-name">' + nvEscape(o.title || (o.qty + ' unidades')) + '</span>' +
        (pct > 0 && (o.title || '').indexOf('%') === -1 ? '<span class="nv-tier-sub">' + (Math.round(pct * 100) / 100) + '% de descuento</span>' : '') +
        '</span><span class="nv-tier-price"><span class="nv-tier-now">—</span><s class="nv-tier-was"></s></span>';
      box.insertBefore(btn, slot);
    });
    var sel = box.querySelector('.nv-tier.active');
    if (sel) document.getElementById('ls-quantity').value = sel.getAttribute('data-qty');
  }

  function nvRenderTiers() {
    var v = nvCurrentVariant();
    if (!v) return;
    document.querySelectorAll('.nv-tier').forEach(function (t) {
      var qty = parseInt(t.getAttribute('data-qty'), 10) || 1;
      var pct = parseFloat(t.getAttribute('data-pct')) || 0;
      var fixed = parseFloat(t.getAttribute('data-fixed')) || 0;
      var full = v.price * qty;
      var now = Math.max(0, full * (1 - pct / 100) - fixed);
      var useCompare = t.getAttribute('data-compare') === '1' && v.compare_at_price && v.compare_at_price > v.price;
      var was = useCompare ? v.compare_at_price * qty : full;
      t.querySelector('.nv-tier-now').textContent = nvFormatMoney(now);
      t.querySelector('.nv-tier-was').textContent = was > now ? nvFormatMoney(was) : '';
    });
  }

  // Cuando se abre el formulario de ReleasIT, marca en él la misma oferta de cantidad
  // que el cliente eligió en la página (ReleasIT siempre abre en la primera).
  // Espera a que el formulario esté visible, toca la tarjeta de la oferta y confirma que
  // quedó marcada; si ReleasIT la reinicia al terminar de abrir, la vuelve a tocar.
  var nvSyncTimer = null;
  function nvSyncOfferToForm() {
    var tiers = Array.prototype.slice.call(document.querySelectorAll('#nv-tiers .nv-tier'));
    var sel = document.querySelector('#nv-tiers .nv-tier.active');
    var idx = tiers.indexOf(sel);
    if (idx <= 0) return; // la primera ya viene marcada
    var title = (sel.getAttribute('data-title') || '').trim();
    var t0 = Date.now(), lastClick = 0, okSince = 0;
    clearTimeout(nvSyncTimer);
    (function poll() {
      var form = document.querySelector('._rsi_main_form_element');
      if (form && form.getBoundingClientRect().height > 0) {
        var radios = Array.prototype.slice.call(form.querySelectorAll('input[name="quantity_offer"]'));
        var target = -1;
        if (title) radios.forEach(function (r, i) {
          var box = r.closest('label') || r.parentElement;
          var t = box && box.querySelector('.rsi-quantity-title');
          if (target < 0 && t && t.textContent.trim() === title) target = i;
        });
        if (target < 0 && idx < radios.length) target = idx;
        if (target >= 0) {
          if (radios[target].checked) {
            if (!okSince) okSince = Date.now();
            if (Date.now() - okSince > 900) return; // se mantuvo marcada: listo
          } else {
            okSince = 0;
            if (Date.now() - lastClick > 400) { (radios[target].closest('label') || radios[target]).click(); lastClick = Date.now(); }
          }
        }
      }
      if (Date.now() - t0 < 9000) nvSyncTimer = setTimeout(poll, 150);
    })();
  }

  function nvSelectTier(tier) {
    document.querySelectorAll('.nv-tier').forEach(function (t) { t.classList.toggle('active', t === tier); });
    document.getElementById('ls-quantity').value = tier.getAttribute('data-qty');
    document.getElementById('ls-quantity').dispatchEvent(new Event('change', { bubbles: true }));
  }

  /* ---------- Botones "Pedir ahora": abren el formulario de ReleasIT ---------- */
  function nvMissingGroups() {
    var missing = [];
    document.querySelectorAll('.ls-variant-group').forEach(function (group) {
      if (!group.querySelector('.ls-swatch-color.active, .ls-swatch-size.active')) missing.push(group);
    });
    return missing;
  }

  /* ---------- Pedido sin variante elegida ----------
     Si tocan "REALIZAR PEDIDO" (cualquier botón de ReleasIT, incluida la barra fija)
     sin haber elegido talla y/o color, se elige automáticamente lo que falte:
     talla "Sencilla" y el primer color disponible en esa talla. Después se espera
     a que ReleasIT actualice su botón y se abre el formulario con esa variante.
     Si no se puede elegir una variante, se muestra un mensaje junto al botón y se
     hace scroll suave a los selectores. */
  var NV_CHOOSE_MSG = 'Elige tu talla y color para continuar';

  function nvSizeOptionIndex() {
    var groups = Array.prototype.slice.call(document.querySelectorAll('.ls-variant-group'));
    var sizeGroups = groups.filter(function (g) { return g.querySelector('.ls-swatch-size'); });
    var byName = sizeGroups.filter(function (g) { return /tama|talla|size|medida/i.test(g.querySelector('.ls-variant-label').textContent); })[0] || sizeGroups[0];
    if (!byName) return -1;
    return parseInt(byName.querySelector('.ls-swatch-size').getAttribute('data-option-index'), 10) - 1;
  }

  function nvAutoSelectDefault() {
    var selected = lsSelectedOptions();
    var sizeIdx = nvSizeOptionIndex();
    var matches = lsProductJson.variants.filter(function (v) {
      return v.available && v.options.every(function (opt, i) { return selected[i] === undefined || opt === selected[i]; });
    });
    var wantSencilla = sizeIdx >= 0 && selected[sizeIdx] === undefined;
    var pick = (wantSencilla && matches.filter(function (v) { return lsNormalizeColor(v.options[sizeIdx]) === 'sencilla'; })[0]) || matches[0];
    if (!pick) return false;
    var order = pick.options.map(function (_, i) { return i; });
    if (sizeIdx > 0) { order.splice(sizeIdx, 1); order.unshift(sizeIdx); } // primero la talla, luego el color
    for (var k = 0; k < order.length; k++) {
      var i = order[k];
      if (lsSelectedOptions()[i] !== undefined) continue;
      var sw = Array.prototype.filter.call(document.querySelectorAll('[data-option-index="' + (i + 1) + '"]'), function (el) {
        return el.getAttribute('data-value') === pick.options[i];
      })[0];
      if (!sw) return false;
      selectLsVariant(sw);
    }
    return nvMissingGroups().length === 0;
  }

  function nvHideChooseMsg() {
    document.querySelectorAll('.nv-choose-msg').forEach(function (el) { el.remove(); });
  }

  function nvShowChooseMsg(btn) {
    nvHideChooseMsg();
    var missing = nvMissingGroups();
    var groups = document.querySelectorAll('.ls-variant-group');
    // Junto a los selectores (siempre visible después del scroll)
    if (groups.length) {
      var top = document.createElement('p');
      top.className = 'nv-choose-msg nv-choose-msg-top';
      top.setAttribute('role', 'alert');
      top.textContent = NV_CHOOSE_MSG;
      groups[0].parentNode.insertBefore(top, groups[0]);
    }
    // Junto al botón que tocaron (si no es la barra fija)
    var slot = btn && btn.closest && btn.closest('.nv-rsi-slot');
    if (slot) {
      var near = document.createElement('p');
      near.className = 'nv-choose-msg';
      near.textContent = NV_CHOOSE_MSG;
      slot.insertAdjacentElement('afterend', near);
    }
    missing.forEach(function (g) { g.classList.remove('nv-missing'); void g.offsetWidth; g.classList.add('nv-missing'); });
    (missing[0] || groups[0] || document.getElementById('nv-comprar')).scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // Después de cambiar la variante, ReleasIT desactiva su botón un momento mientras se
  // actualiza. Se espera a que vuelva a estar activo y entonces se abre el formulario.
  function nvOpenFormWhenReady(sourceBtn) {
    var t0 = Date.now(), sawDisabled = false;
    (function poll() {
      var b = nvOriginalRsiButton();
      if (b && b.disabled) sawDisabled = true;
      var elapsed = Date.now() - t0;
      if (b && !b.disabled && (sawDisabled || elapsed > 1200)) { b.click(); return; }
      if (elapsed < 8000) { setTimeout(poll, 120); return; }
      nvShowChooseMsg(sourceBtn); // ReleasIT nunca quedó listo
    })();
  }

  function nvOrderNow(sourceBtn) {
    if (!nvMissingGroups().length) {
      var btn = nvOriginalRsiButton();
      if (btn) { btn.click(); } else { nvShowChooseMsg(sourceBtn); }
      return;
    }
    if (nvAutoSelectDefault()) { nvHideChooseMsg(); nvOpenFormWhenReady(sourceBtn); }
    else { nvShowChooseMsg(sourceBtn); }
  }

  /* ---------- Botones de ReleasIT ----------
     ReleasIT dibuja su propio botón verde dentro de cada #rsi-button-hook
     (arriba, en "Oferta por cantidad" y en "Última llamada"). Todos son botones
     reales de ReleasIT y abren su formulario directamente. */
  var NV_RSI_BUTTON = '#rsi_buy_now_button, .rsi_buy_now_button, ._rsi-buy-now-button';

  function nvOriginalRsiButton() {
    return document.querySelector('#nv-comprar ' + NV_RSI_BUTTON) || document.querySelector(NV_RSI_BUTTON);
  }


  /* ---------- Lightbox de reseñas ---------- */
  function nvOpenLightbox(src) {
    document.getElementById('nv-lightbox-img').src = src;
    document.getElementById('nv-lightbox').classList.add('open');
  }
  function nvCloseLightbox() { document.getElementById('nv-lightbox').classList.remove('open'); }
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') nvCloseLightbox(); });

  // Todos los botones de ReleasIT (incluida la barra fija de abajo) pasan por aquí.
  // Se escucha en window y en fase de captura para actuar antes que ReleasIT.
  window.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest(NV_RSI_BUTTON);
    if (!btn) return;
    if (!nvMissingGroups().length) { nvHideChooseMsg(); nvSyncOfferToForm(); return; }
    e.preventDefault();
    e.stopImmediatePropagation();
    nvOrderNow(btn);
  }, true);

  /* ---------- Swipe en la galería (celular) ---------- */
  function nvNavigateGallery(dir) {
    var items = Array.prototype.slice.call(document.querySelectorAll('.ls-media-item:not(.ls-media-variant-hidden)'));
    if (items.length <= 1) return;
    var cur = items.findIndex(function (el) { return el.style.display !== 'none'; });
    if (cur === -1) cur = 0;
    var next = (cur + dir + items.length) % items.length;
    var id = items[next].getAttribute('data-media-id');
    var thumb = document.querySelector('.ls-thumb-wrapper[data-media-id="' + id + '"]');
    changeLsMedia(thumb, id);
    if (thumb) thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }

  document.addEventListener('DOMContentLoaded', function () {
    applyLsGalleryVariantFilter('');
    nvBuildTiersFromRsi();
    nvRenderTiers();

    var gallery = document.getElementById('ls-main-gallery');
    if (gallery) {
      var startX = 0;
      gallery.addEventListener('touchstart', function (e) { startX = e.changedTouches[0].screenX; }, { passive: true });
      gallery.addEventListener('touchend', function (e) {
        var endX = e.changedTouches[0].screenX;
        if (endX < startX - 40) nvNavigateGallery(1);
        if (endX > startX + 40) nvNavigateGallery(-1);
      }, { passive: true });
    }
  });

  /* ---------- Carrusel de beneficios ----------
     Loop infinito con copias de la primera y la última imagen en los extremos,
     autoplay que se pausa al tocar/arrastrar y se reanuda después, swipe con el dedo
     y puntos indicadores. Solo avanza cuando el carrusel está visible en pantalla. */
  (function nvPromoCarousel() {
    var vp = document.getElementById('nv-promo');
    if (!vp) return;
    var track = vp.querySelector('.nv-promo-track');
    var slides = Array.prototype.slice.call(track.children);
    var n = slides.length;
    if (n < 2) return;
    var dots = Array.prototype.slice.call(document.querySelectorAll('.nv-promo-dot'));
    var delay = parseInt(vp.getAttribute('data-autoplay'), 10) || 4000;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var firstClone = slides[0].cloneNode(true);
    var lastClone = slides[n - 1].cloneNode(true);
    [firstClone, lastClone].forEach(function (c) {
      c.setAttribute('aria-hidden', 'true');
      var img = c.querySelector('img'); img.removeAttribute('fetchpriority'); img.setAttribute('loading', 'lazy');
    });
    track.appendChild(firstClone);
    track.insertBefore(lastClone, slides[0]);

    var index = 1, timer = null, resumeTimer = null, visible = true, busy = false;

    function setPos(animate, offsetPx) {
      track.classList.toggle('nv-anim', !!animate);
      track.style.transform = 'translate3d(calc(' + (-index * 100) + '% + ' + (offsetPx || 0) + 'px), 0, 0)';
    }
    function realIndex() { return (index - 1 + n) % n; }
    function updateDots() { dots.forEach(function (d, i) { d.classList.toggle('active', i === realIndex()); d.setAttribute('aria-selected', i === realIndex() ? 'true' : 'false'); }); }
    function go(to) {
      if (busy) return;
      index = to; busy = true;
      setPos(!reduceMotion);
      updateDots();
      if (reduceMotion) onEnd();
    }
    function onEnd() {
      busy = false;
      if (index === n + 1) { index = 1; setPos(false); }
      if (index === 0) { index = n; setPos(false); }
    }
    track.addEventListener('transitionend', function (e) { if (e.target === track) onEnd(); });

    function stop() { clearInterval(timer); timer = null; }
    function start() { stop(); if (!reduceMotion && visible && !document.hidden) timer = setInterval(function () { go(index + 1); }, delay); }
    function pauseThenResume() { stop(); clearTimeout(resumeTimer); resumeTimer = setTimeout(start, 3000); }

    // Precarga las demás imágenes cuando la página ya cargó, para que no aparezcan en blanco al deslizar.
    window.addEventListener('load', function () {
      setTimeout(function () { track.querySelectorAll('img[loading="lazy"]').forEach(function (img) { img.loading = 'eager'; }); }, 1200);
    });

    // Swipe / arrastre
    var startX = 0, startY = 0, dx = 0, dragging = false, decided = false, horizontal = false, width = 1;
    vp.addEventListener('pointerdown', function (e) {
      if (e.target.closest('.nv-promo-arrow')) return;
      if (busy) { onEnd(); }
      dragging = true; decided = false; horizontal = false; dx = 0;
      startX = e.clientX; startY = e.clientY; width = vp.clientWidth || 1;
      pauseThenResume();
    });
    window.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      var mx = e.clientX - startX, my = e.clientY - startY;
      if (!decided && (Math.abs(mx) > 6 || Math.abs(my) > 6)) { decided = true; horizontal = Math.abs(mx) > Math.abs(my); if (horizontal) vp.classList.add('nv-dragging'); }
      if (!horizontal) return;
      dx = Math.max(-width, Math.min(width, mx));
      setPos(false, dx);
    });
    function endDrag() {
      if (!dragging) return;
      dragging = false; vp.classList.remove('nv-dragging');
      if (!horizontal) return;
      if (Math.abs(dx) > width * 0.15) { go(index + (dx < 0 ? 1 : -1)); } else { setPos(true); }
      pauseThenResume();
    }
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    dots.forEach(function (d, i) { d.addEventListener('click', function () { go(i + 1); pauseThenResume(); }); });
    var prev = vp.querySelector('.nv-promo-prev'), next = vp.querySelector('.nv-promo-next');
    if (prev) prev.addEventListener('click', function () { go(index - 1); pauseThenResume(); });
    if (next) next.addEventListener('click', function () { go(index + 1); pauseThenResume(); });
    vp.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { go(index + 1); pauseThenResume(); }
      if (e.key === 'ArrowLeft') { go(index - 1); pauseThenResume(); }
    });

    // Solo corre cuando se ve y la pestaña está activa.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) { visible = entries[0].isIntersecting; visible ? start() : stop(); }, { threshold: 0.35 }).observe(vp);
    }
    document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });

    setPos(false);
    updateDots();
    start();
  })();
</script>

{% schema %}
{
  "name": "Nueva Página",
  "settings": [
    {
      "type": "header",
      "content": "Encabezado del producto"
    },
    {
      "type": "text",
      "id": "badge_left",
      "label": "Etiqueta sobre la foto",
      "default": "⭐ 4.9 · Clientes felices"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Texto de calificación",
      "default": "4.9/5 · +2.000 juegos vendidos"
    },
    {
      "type": "select",
      "id": "title_source",
      "label": "Título principal",
      "options": [
        {
          "value": "product",
          "label": "Nombre del producto"
        },
        {
          "value": "headline",
          "label": "Título de abajo"
        }
      ],
      "default": "product",
      "info": "Con \"Nombre del producto\", el título de abajo se muestra como texto debajo del precio."
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Título",
      "default": "Renueva tu habitación con sábanas suaves y de ajuste perfecto"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subtítulo",
      "default": "Descansa mejor cada noche con sábanas cómodas, elegantes y fáciles de cuidar. Textura suave, cero motas y elásticos que no se salen del colchón."
    },
    {
      "type": "text",
      "id": "perks",
