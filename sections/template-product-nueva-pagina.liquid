        <div class="nv-reviews">
          {% assign nv_shown = 0 %}
          {% for i in (1..10) %}
            {% assign rn = 'review_' | append: i | append: '_name' %}
            {% assign rt = 'review_' | append: i | append: '_text' %}
            {% assign ri = 'review_' | append: i | append: '_image' %}
