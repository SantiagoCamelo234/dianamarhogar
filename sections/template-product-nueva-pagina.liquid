      <div class="nv-wrap">
        <div class="nv-head">
          <span class="nv-eyebrow">Guía de medidas</span>
          <h2>{{ s.size_guide_title }}</h2>
          <p>{% if s.show_g3 %}Elige un tamaño, gira la cama y mira cómo queda la sábana en tu colchón.{% else %}Mide el ancho, el largo y el alto de tu colchón y elige el tamaño que corresponde.{% endif %}</p>
        </div>
        {%- capture tabla_html -%}
        <div class="nv-table-box">
          <table class="nv-size-table">
            <thead><tr><th>Tamaño</th><th>Colchón (ancho × largo)</th>{% if s.size_height != blank %}<th>Alto</th>{% endif %}<th>Fundas incluidas</th></tr></thead>
            <tbody>
              {% for i in (1..6) %}
                {% assign zn = 'size_' | append: i | append: '_name' %}
                {% assign zm = 'size_' | append: i | append: '_measure' %}
                {% assign zf = 'size_' | append: i | append: '_cases' %}
                {% if s[zn] != blank %}
                  <tr data-size="{{ s[zn] | escape }}"><td>{{ s[zn] }}</td><td>{{ s[zm] }}</td>{% if s.size_height != blank %}<td>{{ s.size_height }}</td>{% endif %}<td>{{ s[zf] }}</td></tr>
                {% endif %}
              {% endfor %}
            </tbody>
          </table>
        </div>
        {%- endcapture -%}
        {%- if s.show_g3 -%}
          {% render 'dh-size-guide-3d', s: s, product: product, table: tabla_html %}
        {%- else -%}
          {{ tabla_html }}
        {%- endif -%}
      </div>
    </section>
  {% elsif s.size_guide_image != blank %}
    <section class="nv-sec nv-alt" id="nv-medidas">
      <div class="nv-wrap">
        <div class="nv-head">
          <span class="nv-eyebrow">Guía de medidas</span>
          <h2>{{ s.size_guide_title }}</h2>
        </div>
        <img src="{{ s.size_guide_image | image_url: width: 1200 }}" alt="Guía de medidas" width="{{ s.size_guide_image.width }}" height="{{ s.size_guide_image.height }}" loading="lazy" style="display: block; width: 100%; max-width: 900px; height: auto; margin: 0 auto; border-radius: 14px;">
