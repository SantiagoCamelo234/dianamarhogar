{%- comment -%}
  Catálogo de la tienda nueva. Los filtros son los de Shopify
  (Tienda online → Search & Discovery → Filtros). Si no hay filtros
  configurados, la columna de filtros no aparece.
{%- endcomment -%}
{%- paginate collection.products by section.settings.per_page -%}
{%- liquid
  assign chips = section.blocks | where: 'type', 'chip'
  assign has_filters = false
  for f in collection.filters
    if f.type == 'list' or f.type == 'price_range'
      assign has_filters = true
    endif
  endfor
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}
<div class="dh-section" style="padding-top: 28px;">
  <div class="dh-wrap">
    <nav class="dh-crumbs" aria-label="Ruta"><a href="{{ routes.root_url }}">Inicio</a> / <span>{{ collection.title }}</span></nav>

    <div class="dh-coll-head">
      <div>
        <h1>{% if collection.handle == 'all' %}Toda la tienda{% else %}{{ collection.title }}{% endif %}</h1>
        <p>{{ collection.products_count }} {% if collection.products_count == 1 %}producto{% else %}productos{% endif %} · pago contra entrega o Mercado Pago</p>
      </div>
      <div class="dh-coll-tools" style="display: flex; gap: 8px; align-items: center;">
        {%- if has_filters -%}
          <button type="button" class="dh-btn dh-btn-soft dh-filter-toggle" data-dh-filter-toggle aria-expanded="false" aria-controls="dh-filters" style="min-height: 44px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg> Filtrar
          </button>
        {%- endif -%}
        <label class="dh-sr" for="dh-sort">Ordenar por</label>
        <select id="dh-sort" class="dh-select" data-dh-sort>
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </div>
    </div>

    {%- if chips.size > 0 -%}
      <div class="dh-rail dh-coll-chips" aria-label="Categorías">
        <a class="dh-chip {% if collection.handle == 'all' %}is-active{% endif %}" href="{{ routes.all_products_collection_url }}">Todo</a>
        {%- for block in chips -%}
          <a class="dh-chip {% if request.path == block.settings.link %}is-active{% endif %}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.title }}</a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div style="height: 22px;"></div>
    {%- endif -%}

    <div class="dh-coll-layout">
      {%- if has_filters -%}
        <form class="dh-filters" id="dh-filters" data-dh-filters method="get" action="{{ collection.url }}" aria-label="Filtros">
          {%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{%- endif -%}
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'list' -%}
              <fieldset>
                <legend>{{ filter.label }}</legend>
                {%- for value in filter.values -%}
                  <label>
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                    {{ value.label }} <span style="color: var(--dh-muted); font-size: 13px;">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
              </fieldset>
            {%- elsif filter.type == 'price_range' -%}
              <fieldset>
                <legend>{{ filter.label }}</legend>
                <div style="display: flex; gap: 8px; align-items: center;">
                  <label class="dh-sr" for="dh-pmin">Precio mínimo</label>
                  <input id="dh-pmin" class="dh-select" style="width: 100%;" type="number" inputmode="numeric" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100 }}{% endif %}" placeholder="Desde">
                  <span aria-hidden="true">–</span>
                  <label class="dh-sr" for="dh-pmax">Precio máximo</label>
                  <input id="dh-pmax" class="dh-select" style="width: 100%;" type="number" inputmode="numeric" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100 }}{% endif %}" placeholder="Hasta">
                </div>
              </fieldset>
            {%- endif -%}
          {%- endfor -%}
          <div class="dh-filters-actions">
            <button type="submit" class="dh-btn dh-btn-primary" style="min-height: 44px;">Aplicar</button>
            <a class="dh-btn dh-btn-soft" style="min-height: 44px;" href="{{ collection.url }}{% if collection.sort_by != blank %}?sort_by={{ collection.sort_by }}{% endif %}">Limpiar</a>
          </div>
        </form>
      {%- endif -%}

      <div class="dh-coll-grid">
        <div class="dh-grid">
          {%- for product in collection.products -%}
            {% render 'dh-product-card', product: product, collection: collection, eager: forloop.first %}
          {%- else -%}
            <p class="dh-empty">No encontramos productos con esos filtros. <a class="dh-link" href="{{ collection.url }}">Ver todos</a></p>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="dh-pagination" aria-label="Páginas">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Página anterior">‹</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}<span class="is-current" aria-current="page">{{ part.title }}</span>
              {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Página siguiente">›</a>{%- endif -%}
          </nav>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Catálogo",
  "max_blocks": 12,
  "settings": [
    { "type": "range", "id": "per_page", "label": "Productos por página", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "paragraph", "content": "Agrega bloques \"Categoría\" para los botones de arriba (Sábanas, Protectores...). Los filtros de tamaño, color y precio se activan en Search & Discovery." },
    { "type": "image_picker", "id": "fallback_image", "label": "Imagen de respaldo (ya no se usa en este diseño)" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Categoría",
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre", "default": "Sábanas" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ]
}
{% endschema %}
