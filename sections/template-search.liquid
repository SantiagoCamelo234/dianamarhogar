{%- paginate search.results by 24 -%}
<div class="dh-section" style="padding-top: 28px;">
  <div class="dh-wrap">
    <nav class="dh-crumbs" aria-label="Ruta"><a href="{{ routes.root_url }}">Inicio</a> / <span>Búsqueda</span></nav>
    <div class="dh-coll-head" style="margin-bottom: 24px;">
      <div>
        <h1>{% if search.performed %}Resultados para “{{ search.terms | escape }}”{% else %}Buscar productos{% endif %}</h1>
        {%- if search.performed -%}<p>{{ search.results_count }} {% if search.results_count == 1 %}resultado{% else %}resultados{% endif %}</p>{%- endif -%}
      </div>
      <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; gap: 8px; flex: 1 1 320px; max-width: 480px;">
        <label class="dh-sr" for="dh-search-page">Buscar</label>
        <input id="dh-search-page" class="dh-select" style="flex: 1; min-width: 0; font-size: 16px;" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Ej. sábanas doble">
        <input type="hidden" name="type" value="product">
        <button type="submit" class="dh-btn dh-btn-primary" style="min-height: 44px;">Buscar</button>
      </form>
    </div>

    <div class="dh-coll-grid">
      <div class="dh-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'dh-product-card', product: item, eager: forloop.first %}
          {%- endif -%}
        {%- else -%}
          {%- if search.performed -%}
            <p class="dh-empty">No encontramos productos para “{{ search.terms | escape }}”. Prueba con otra palabra o <a class="dh-link" href="{{ routes.all_products_collection_url }}">mira toda la tienda</a>.</p>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="dh-pagination" aria-label="Páginas">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Página anterior">‹</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}<span class="is-current" aria-current="page">{{ part.title }}</span>
            {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Página siguiente">›</a>{%- endif -%}
        </nav>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Resultados de búsqueda",
  "settings": []
}
{% endschema %}
