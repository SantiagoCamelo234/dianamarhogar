<div class="cart-wrapper-view">
  <h2 class="cart-title">🛒 Tu Carrito</h2>

  {% if cart.item_count > 0 %}
    <!-- Barra de progreso Envío Gratis Dinámica -->
    {% assign threshold_cents = 30000000 %} <!-- Shopify cart envíos gratis = $300.000 COP = 30.000.000 centavos -->
    {% assign current_total = cart.total_price %}
    {% assign missing_cents = threshold_cents | minus: current_total %}
    {% assign progress = current_total | times: 100.0 | divided_by: threshold_cents %}
    {% if progress > 100 %}{% assign progress = 100 %}{% endif %}

    <div class="shipping-progress-container" id="shipping-progress-container" style="margin-bottom: 20px; background: white; padding: 18px 20px; border-radius: 10px; border: 1px solid var(--border-color);">
      <div id="shipping-progress-text" style="font-size: 13px; color: var(--text-main); font-weight: 600; margin-bottom: 12px; text-align: center;">
        {% if missing_cents > 0 %}
          🚚 ¡Solo te faltan <strong>{{ missing_cents | money }}</strong> para envío GRATIS!
        {% else %}
          🎉 ¡Felicidades! Tienes <strong>Envío GRATIS</strong> 🚚
        {% endif %}
      </div>
      <div style="width: 100%; height: 10px; background: var(--bg-color); border-radius: 5px; overflow: hidden;">
        <div id="shipping-progress-bar" style="height: 100%; width: {{ progress }}%; background: linear-gradient(90deg, #1d6b4e, #27ae60); border-radius: 5px; transition: width 0.5s ease;"></div>
      </div>
    </div>

    <!-- Urgencia en el carrito -->
    <div class="cart-urgency">
      <span class="urgency-dot"></span>
      🔥 ¡Últimas unidades! No pierdas tu reserva
    </div>

    <a href="{{ routes.all_products_collection_url }}" class="btn-seguir-comprando" style="display: flex; justify-content: center; align-items: center; width: 100%; text-align: center; margin-bottom: 20px; text-decoration: none; box-sizing: border-box;">← Seguir Comprando</a>

    <div class="cart-grid">
      <!-- Productos -->
      <div class="cart-items" id="cart-items-container">
        {% for item in cart.items %}
          <div class="cart-item" id="cart-item-{{ item.key | replace: ':', '-' }}" data-item-key="{{ item.key }}">
            <div class="cart-item-img">
              <a href="{{ item.url }}">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" width="300" height="300" loading="lazy">
                {% endif %}
              </a>
            </div>
            <div class="cart-item-info">
              <h4><a href="{{ item.url }}" style="color: inherit; text-decoration: none;">{{ item.product.title }}</a></h4>
              {% unless item.variant.title contains 'Default' %}
                <div class="cart-item-variant">{{ item.variant.title }}</div>
              {% endunless %}
              <div class="cart-item-price" id="price-{{ item.key | replace: ':', '-' }}">{{ item.line_price | money }}</div>
              <!-- Stock: inventory_quantity via JS -->
              <div class="cart-qty-wrapper"
                data-item-key="{{ item.key }}"
                data-variant-id="{{ item.variant_id }}"
                data-unit-price="{{ item.price }}"
                data-compare-price="{{ item.variant.compare_at_price | default: 0 }}"
                data-max-qty="{{ item.variant.inventory_quantity | default: 99 }}"
                data-inventory-policy="{{ item.variant.inventory_policy }}">
                <button type="button" class="qty-btn qty-minus" aria-label="Reducir cantidad">−</button>
                <input
                  type="number"
                  class="qty-input"
                  value="{{ item.quantity }}"
                  min="0"
                  max="{{ item.variant.inventory_quantity | default: 99 }}"
                  aria-label="Cantidad de {{ item.product.title }}"
                >
                <button type="button" class="qty-btn qty-plus" aria-label="Aumentar cantidad">+</button>
              </div>
              <div class="cart-item-stock-msg" id="stock-msg-{{ item.key | replace: ':', '-' }}" style="font-size: 11px; color: var(--accent-pink); margin-top: 4px; min-height: 14px;"></div>
            </div>
            <button
              class="cart-item-remove"
              title="Eliminar producto"
              style="color: var(--text-light); background: none; border: none; cursor: pointer; font-size: 16px;"
              data-item-key="{{ item.key }}"
              aria-label="Eliminar {{ item.product.title }}">
              ✕
            </button>
          </div>
        {% endfor %}
      </div>

      <!-- Resumen -->
      <div class="cart-summary">
        <h3 class="cart-summary-title">Resumen del Pedido</h3>
        <div class="cart-summary-line">
          <span>Subtotal</span>
          <span id="cart-subtotal">{{ cart.total_price | money }}</span>
        </div>

        {% comment %} Cálculo de ahorro total en Liquid (estado inicial) {% endcomment %}
        {% assign total_savings_cents = 0 %}
        {% for item in cart.items %}
          {% if item.variant.compare_at_price > item.variant.price %}
            {% assign item_saving = item.variant.compare_at_price | minus: item.variant.price %}
            {% assign item_saving_total = item_saving | times: item.quantity %}
            {% assign total_savings_cents = total_savings_cents | plus: item_saving_total %}
          {% endif %}
        {% endfor %}

        <div id="cart-savings-line" class="cart-savings-badge" {% if total_savings_cents == 0 %}style="display:none;"{% endif %}>
          <div class="cart-savings-badge-inner">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>¡Ahorras en este pedido!</span>
          </div>
          <span id="cart-savings-amount" class="cart-savings-amount">{{ total_savings_cents | money }}</span>
        </div>

        {% comment %} Lógica de Envío Dinámica {% endcomment %}
        {% assign shipping_fee_cents = 1500000 %}
        {% assign threshold_cents = 30000000 %}
        
        {% if cart.total_price >= threshold_cents %}
          {% assign current_shipping_cents = 0 %}
          {% assign shipping_text = "Gratis" %}
        {% else %}
          {% assign current_shipping_cents = shipping_fee_cents %}
          {% assign shipping_text = shipping_fee_cents | money %}
        {% endif %}
        {% assign cart_total_with_shipping = cart.total_price | plus: current_shipping_cents %}

        <div class="cart-summary-line">
          <span>Envío</span>
          <span id="cart-shipping-cost" style="color: var(--accent-green); font-weight: 600;">{{ shipping_text }}</span>
        </div>
        <div class="cart-summary-line total">
          <span>Total a Pagar</span>
          <span id="cart-total">{{ cart_total_with_shipping | money }}</span>
        </div>
        <a href="/checkout" class="cart-checkout-btn btn-animated" id="cart-checkout-btn">
          📦 PEDIR AHORA Y PAGAR EN CASA
        </a>
        <div class="cart-checkout-subtext">✅ Sin pagos adelantados — pagas al recibir</div>

        <!-- PAYMENT TRUST ICONS -->
        <div class="cart-trust-badges" style="margin-top: 20px; text-align: center;">
          <div style="font-size: 11px; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px; font-weight: 600;">Pago 100% Seguro y Encriptado</div>
          <div style="display: flex; justify-content: center; gap: 15px; align-items: center; opacity: 0.9;">
            <img src="https://upload.wikimedia.org/wikipedia/commons/d/d3/Visa_Inc._logo_%282005%E2%80%932014%29.png" alt="Visa" width="42" height="14" style="height: 14px; width: auto;">
            <img src="https://upload.wikimedia.org/wikipedia/commons/b/b7/MasterCard_Logo.svg" alt="Mastercard" width="30" height="18" style="height: 18px; width: auto;">
            <img src="https://static.wikia.nocookie.net/logopedia/images/7/79/Logotipo_de_Mercado_Pago_alternativo.svg/revision/latest/scale-to-width-down/250?cb=20250802020358&path-prefix=es" alt="Mercado Pago" width="80" height="18" style="height: 18px; width: auto;">
            <img src="https://juntanacional.co/wp-content/uploads/2015/08/logo_380.png" alt="PSE" width="50" height="18" style="height: 18px; width: auto;">
          </div>
          <div style="font-size: 11px; color: var(--text-light); margin-top: 12px; display: flex; align-items: center; justify-content: center; gap: 5px;">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
            SSL de 256 bits
          </div>

          <!-- PAGO CONTRAENTREGA -->
          <div style="margin-top: 14px; background: #eaf4ee; border: 1px solid #9db0a3; border-radius: 10px; padding: 12px 14px; display: flex; align-items: center; gap: 10px; text-align: left;">
            <span style="font-size: 24px; flex-shrink: 0;">💰</span>
            <div>
              <div style="font-size: 13px; font-weight: 800; color: #1d6b4e; margin-bottom: 2px;">Pago Contraentrega disponible</div>
              <div style="font-size: 12px; color: #3a6649; line-height: 1.4;">Pagas solo cuando recibas tu pedido — a todo el país 🇨🇴</div>
            </div>
          </div>
        </div>
      </div>
    </div>

  {% else %}
    <!-- Vista si el carrito está vacío -->
    <div id="cart-empty-state" style="text-align: center; margin-top: 50px;">
      <p style="margin-bottom: 25px;">Tu carrito está vacío actualmente.</p>
      <a href="/collections/all" class="btn-primary" style="text-decoration: none;">Volver a la tienda</a>
    </div>
  {% endif %}
</div>

<!-- Loading overlay -->
<div id="cart-loading" style="display:none; position:fixed; inset:0; background:rgba(255,255,255,0.5); z-index:9999; align-items:center; justify-content:center;">
  <div style="width:40px;height:40px;border:3px solid var(--border-color);border-top-color:var(--accent-pink);border-radius:50%;animation:cart-spin 0.7s linear infinite;"></div>
</div>

<style>
  /* CTA Animation */
  @keyframes pulse-cta {
    0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(29,107,78,0.25); }
    70% { transform: scale(1.02); box-shadow: 0 0 0 10px rgba(29,107,78,0); }
    100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(29,107,78,0); }
  }
  @keyframes cart-spin {
    to { transform: rotate(360deg); }
  }
  .btn-animated { animation: pulse-cta 2.2s infinite; }

  /* Checkout button — verde esmeralda, igual que product page */
  .cart-checkout-btn {
    display: block;
    text-align: center;
    text-decoration: none;
    width: 100%;
    box-sizing: border-box;
    background: linear-gradient(135deg, #1d6b4e, #229e6c);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 16px 20px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    box-shadow: 0 5px 18px rgba(29,107,78,0.35);
    transition: background 0.3s ease, transform 0.2s ease;
    margin-top: 18px;
  }
  .cart-checkout-btn:hover {
    background: linear-gradient(135deg, #155a40, #1d8a5c);
    transform: translateY(-2px);
  }
  .cart-checkout-subtext {
    text-align: center;
    font-size: 12px;
    color: #3a6649;
    font-weight: 600;
    margin-top: 8px;
    margin-bottom: 4px;
  }

  /* Urgencia en el carrito */
  .cart-urgency {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #fdecea;
    border: 1px solid #f5c0b8;
    color: #8b3a28;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    padding: 9px 16px;
    border-radius: 8px;
    margin-bottom: 14px;
    animation: urgency-pulse 2.5s ease-in-out infinite;
    box-shadow: none;
  }

  /* Botón Seguir Comprando */
  .btn-seguir-comprando {
    background: none;
    border: 1px solid var(--border-color);
    color: var(--text-light);
    font-size: 13px;
    font-weight: 500;
    padding: 10px 16px;
    border-radius: 6px;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-seguir-comprando:hover {
    border-color: var(--text-main);
    color: var(--text-main);
  }
  .qty-btn {
    background: none;
    border: none;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 18px;
    color: var(--text-main);
    transition: color 0.2s;
  }
  .qty-btn:hover { color: var(--accent-pink); }
  .qty-btn:disabled { opacity: 0.35; cursor: not-allowed; }
  .qty-input { text-align: center; }

  /* BADGE DE AHORRO */
  .cart-savings-badge {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(135deg, #eaf4ee, #f0f8f2);
    border: 1px solid #9db0a3;
    border-radius: 8px;
    padding: 11px 15px;
    margin: 8px 0 14px;
    gap: 8px;
    animation: savings-pop 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
  }
  @keyframes savings-pop {
    from { opacity: 0; transform: scale(0.95); }
    to   { opacity: 1; transform: scale(1); }
  }
  .cart-savings-badge-inner {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 600;
    color: #3a6649;
  }
  .cart-savings-badge-inner svg {
    flex-shrink: 0;
    stroke: #3a6649;
  }
  .cart-savings-amount {
    font-size: 14px;
    font-weight: 800;
    color: #3a6649;
    white-space: nowrap;
  }

  /* RESPONSIVE: TABLETS (max-width: 900px) */
  @media (max-width: 900px) {
    .cart-wrapper-view { margin: 30px auto; padding: 0 15px; }
    .cart-title { font-size: 26px; margin-bottom: 25px; }
    .cart-grid { grid-template-columns: 1fr; gap: 30px; }
    .cart-summary { padding: 25px; }
  }

  /* RESPONSIVE: PHONES (max-width: 768px) */
  @media (max-width: 768px) {
    .cart-wrapper-view { margin: 25px auto; }
    .cart-title { font-size: 24px; margin-bottom: 20px; }
    .cart-item { grid-template-columns: 90px 1fr auto; gap: 15px; padding-bottom: 20px; }
    .cart-item-info h4 { font-size: 15px; }
    .cart-item-variant { font-size: 12px; }
    .cart-item-price { font-size: 15px; margin-bottom: 10px; }
    .cart-qty-wrapper { width: 90px; height: 34px; }
    .cart-summary { padding: 20px; }
    .cart-summary-title { font-size: 20px; }
    .cart-checkout-btn { padding: 14px; font-size: 12px; min-height: 48px; }
    .cart-trust-badges img { height: 14px !important; }
  }

  /* RESPONSIVE: SMALL PHONES (max-width: 480px) */
  @media (max-width: 480px) {
    .cart-wrapper-view { margin: 20px auto; padding: 0 12px; }
    .cart-title { font-size: 22px; margin-bottom: 15px; }
    .cart-item { grid-template-columns: 80px 1fr; gap: 12px; position: relative; }
    .cart-item-remove { position: absolute; top: 0; right: 0; }
    .cart-item-info h4 { font-size: 14px; }
    .cart-item-variant { font-size: 11px; }
    .cart-item-price { font-size: 14px; }
    .cart-qty-wrapper { width: 85px; height: 32px; }
    .cart-summary { padding: 18px 15px; }
    .cart-summary-title { font-size: 18px; }
    .cart-summary-line { font-size: 13px; }
    .cart-summary-line.total { font-size: 16px; }
    .cart-checkout-btn { padding: 14px; font-size: 12px; min-height: 50px; border-radius: 6px; }
    .cart-trust-badges img { height: 12px !important; }
  }
</style>

<script>
(function() {
  // ── Configuración ─────────────────────────────────────────────────────────
  const THRESHOLD_CENTS = 30000000; // $300.000 COP en centavos de Shopify
  const SHIPPING_FEE_CENTS = 1500000; // $15.000 COP en centavos de Shopify

  // ── Helpers ───────────────────────────────────────────────────────────────
  function formatMoney(cents) {
    // Shopify guarda precios en centavos: 1 COP = 100 centavos
    // Dividimos por 100 para obtener pesos colombianos
    return '$\u00a0' + Math.round(cents / 100).toLocaleString('es-CO');
  }

  function showLoading(show) {
    const el = document.getElementById('cart-loading');
    if (el) el.style.display = show ? 'flex' : 'none';
  }

  // ── Actualizar UI de progreso de envío ────────────────────────────────────
  function updateShippingProgress(totalCents) {
    const bar = document.getElementById('shipping-progress-bar');
    const text = document.getElementById('shipping-progress-text');
    if (!bar || !text) return;

    const progress = Math.min((totalCents / THRESHOLD_CENTS) * 100, 100);
    bar.style.width = progress + '%';

    const missing = THRESHOLD_CENTS - totalCents;
    if (missing > 0) {
      text.innerHTML = '¡Estás a solo <strong>' + formatMoney(missing) + '</strong> de obtener envío GRATIS! 🚚';
    } else {
      text.innerHTML = '¡Felicidades! Tienes <strong>Envío GRATIS</strong> 🚚';
    }
  }

  // ── Actualizar totales en el resumen ──────────────────────────────────────
  function updateSummary(totalCents) {
    const subtotalEl = document.getElementById('cart-subtotal');
    const shippingEl = document.getElementById('cart-shipping-cost');
    const totalEl    = document.getElementById('cart-total');
    
    if (subtotalEl) subtotalEl.textContent = formatMoney(totalCents);
    
    let currentShipping = 0;
    if (totalCents >= THRESHOLD_CENTS) {
      if (shippingEl) shippingEl.textContent = "Gratis";
      currentShipping = 0;
    } else {
      if (shippingEl) shippingEl.textContent = formatMoney(SHIPPING_FEE_CENTS);
      currentShipping = SHIPPING_FEE_CENTS;
    }
    
    if (totalEl) totalEl.textContent = formatMoney(totalCents + currentShipping);
    
    updateShippingProgress(totalCents);
  }

  // ── Actualizar precio de línea del ítem ───────────────────────────────────
  function updateLinePrice(itemKey, qty) {
    const safeKey = itemKey.replace(/:/g, '-');
    const wrapper = document.querySelector('[data-item-key="' + itemKey + '"].cart-qty-wrapper');
    if (!wrapper) return;
    const unitPrice = parseInt(wrapper.dataset.unitPrice, 10);
    const lineEl = document.getElementById('price-' + safeKey);
    if (lineEl) lineEl.textContent = formatMoney(unitPrice * qty);
  }

  // ── Llamar a la Shopify Cart API ──────────────────────────────────────────
  async function updateCartItem(itemKey, quantity) {
    showLoading(true);
    try {
      const response = await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: itemKey, quantity: quantity })
      });

      if (!response.ok) throw new Error('Cart API error ' + response.status);

      const cart = await response.json();

      // Si qty = 0, remover el elemento del DOM
      if (quantity === 0) {
        const safeKey = itemKey.replace(/:/g, '-');
        const itemEl = document.getElementById('cart-item-' + safeKey);
        if (itemEl) {
          itemEl.style.transition = 'opacity 0.3s, transform 0.3s';
          itemEl.style.opacity = '0';
          itemEl.style.transform = 'translateX(20px)';
          setTimeout(() => itemEl.remove(), 320);
        }
        // Si el carrito queda vacío, recargar para mostrar estado vacío
        if (cart.item_count === 0) {
          setTimeout(() => location.reload(), 400);
          return;
        }
      }

      updateSummary(cart.total_price);

      // Si qty = 0: esperar a que la animación de salida termine antes de recalcular
      if (quantity === 0) {
        setTimeout(updateSavings, 350);
      } else {
        updateSavings();
      }

      // Recalcular el precio de línea exacto desde la respuesta de la API
      const updatedItem = cart.items.find(i => i.key === itemKey);
      if (updatedItem) {
        const safeKey = itemKey.replace(/:/g, '-');
        const lineEl = document.getElementById('price-' + safeKey);
        if (lineEl) lineEl.textContent = formatMoney(updatedItem.line_price);
      }

    } catch (err) {
      console.error('Error actualizando carrito:', err);
      alert('Hubo un error actualizando el carrito. Por favor recarga la página.');
    } finally {
      showLoading(false);
    }
  }

  // ── Calcular y mostrar ahorro total (lee del DOM, inmune a API null) ────────
  function updateSavings() {
    let totalSavingsCents = 0;

    // Recorre los wrappers de cantidad que siguen en el DOM (los no eliminados)
    document.querySelectorAll('.cart-qty-wrapper').forEach(function(wrapper) {
      const comparePrice = parseInt(wrapper.dataset.comparePrice || '0', 10);
      const unitPrice    = parseInt(wrapper.dataset.unitPrice    || '0', 10);
      const qtyInput     = wrapper.querySelector('.qty-input');
      const qty          = qtyInput ? parseInt(qtyInput.value || '0', 10) : 0;

      if (comparePrice > unitPrice && qty > 0) {
        totalSavingsCents += (comparePrice - unitPrice) * qty;
      }
    });

    const badge    = document.getElementById('cart-savings-line');
    const amountEl = document.getElementById('cart-savings-amount');
    if (!badge || !amountEl) return;

    if (totalSavingsCents > 0) {
      amountEl.textContent = formatMoney(totalSavingsCents);
      badge.style.display  = '';
    } else {
      // No hay descuentos activos → ocultar
      badge.style.display = 'none';
    }
  }

  // ── Verificar stock de una variante ──────────────────────────────────────
  async function checkVariantStock(variantId, requestedQty, stockMsgEl, plusBtn) {
    try {
      const res = await fetch('/variants/' + variantId + '.js');
      if (!res.ok) return null;
      const variant = await res.json();

      const policy = variant.inventory_policy; // 'deny' o 'continue'
      const available = variant.inventory_quantity;

      if (policy === 'deny' && requestedQty >= available) {
        if (plusBtn) plusBtn.disabled = true;
        if (stockMsgEl) {
          stockMsgEl.textContent = available <= 0
            ? 'Sin stock disponible'
            : 'Stock máximo: ' + available;
        }
        return available;
      } else {
        if (plusBtn) plusBtn.disabled = false;
        if (stockMsgEl) stockMsgEl.textContent = '';
        return available;
      }
    } catch (e) {
      return null;
    }
  }

  // ── Inicializar controles de cantidad ─────────────────────────────────────
  function initCartControls() {
    document.querySelectorAll('.cart-qty-wrapper').forEach(function(wrapper) {
      const itemKey    = wrapper.dataset.itemKey;
      const variantId  = wrapper.dataset.variantId;
      const policy     = wrapper.dataset.inventoryPolicy;
      const maxQty     = parseInt(wrapper.dataset.maxQty, 10) || 99;
      const safeKey    = itemKey.replace(/:/g, '-');

      const input      = wrapper.querySelector('.qty-input');
      const minusBtn   = wrapper.querySelector('.qty-minus');
      const plusBtn    = wrapper.querySelector('.qty-plus');
      const stockMsg   = document.getElementById('stock-msg-' + safeKey);

      // Verificar stock inicial
      if (policy === 'deny') {
        checkVariantStock(variantId, parseInt(input.value, 10), stockMsg, plusBtn);
      }

      // Botón MENOS
      minusBtn.addEventListener('click', async function() {
        let qty = parseInt(input.value, 10);
        if (qty <= 0) return;
        qty -= 1;
        input.value = qty;
        minusBtn.disabled = qty <= 0;
        updateLinePrice(itemKey, qty);
        await updateCartItem(itemKey, qty);
        if (policy === 'deny') {
          await checkVariantStock(variantId, qty, stockMsg, plusBtn);
        }
      });

      // Botón MÁS
      plusBtn.addEventListener('click', async function() {
        let qty = parseInt(input.value, 10);
        // Verificar stock antes de incrementar
        if (policy === 'deny' && qty >= maxQty) {
          if (stockMsg) stockMsg.textContent = 'Stock máximo: ' + maxQty;
          return;
        }
        qty += 1;
        input.value = qty;
        minusBtn.disabled = false;
        updateLinePrice(itemKey, qty);
        await updateCartItem(itemKey, qty);
        if (policy === 'deny') {
          await checkVariantStock(variantId, qty, stockMsg, plusBtn);
        }
      });

      // Edición directa del input
      let debounceTimer;
      input.addEventListener('change', async function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(async () => {
          let qty = parseInt(input.value, 10);
          if (isNaN(qty) || qty < 0) { qty = 0; input.value = 0; }
          if (policy === 'deny' && qty > maxQty) { qty = maxQty; input.value = maxQty; }
          minusBtn.disabled = qty <= 0;
          updateLinePrice(itemKey, qty);
          await updateCartItem(itemKey, qty);
          if (policy === 'deny') {
            await checkVariantStock(variantId, qty, stockMsg, plusBtn);
          }
        }, 400);
      });
    });

    // Botones eliminar
    document.querySelectorAll('.cart-item-remove[data-item-key]').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        const key = btn.dataset.itemKey;
        await updateCartItem(key, 0);
      });
    });
  }

  // Arrancar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCartControls);
  } else {
    initCartControls();
  }
})();
</script>
