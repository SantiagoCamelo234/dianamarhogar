<!-- SIDEBAR MENU -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
<div class="sidebar" id="sidebarMenu">
  <div class="sidebar-header">
    <div class="logo-simulado" style="margin: 0; text-align: left; cursor: default;">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" class="logo-img" width="200" height="80" style="max-height: 40px; width: auto;">
      {% else %}
        <div class="logo-text-container" style="margin-left: 0;">
          <div class="logo-dianamar" style="font-size: 22px;">{{ shop.name }}</div>
        </div>
      {% endif %}
    </div>
    <button class="close-sidebar" onclick="toggleSidebar()">✕</button>
  </div>
  <ul class="sidebar-links">
    {% if section.settings.menu_type == 'automatic' %}
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' %}
          <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
        {% endunless %}
      {% endfor %}
    {% else %}
      {% for link in linklists[section.settings.menu].links %}
        {% if link.links != blank %}
          <li class="has-submenu">
            <div class="submenu-toggle" onclick="toggleSubmenu(this)">
              {{ link.title }} <span class="submenu-icon">+</span>
            </div>
            <ul class="submenu">
              {% for childlink in link.links %}
                <li><a href="{{ childlink.url }}">{{ childlink.title }}</a></li>
              {% endfor %}
            </ul>
          </li>
        {% else %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endif %}
      {% else %}
        <!-- Fallback provisional en Shopify si el menú configurado no existe -->
        <li><a href="/collections/all">Ver Catálogo completo</a></li>
      {% endfor %}
    {% endif %}
  </ul>
</div>

<!-- BARRA DE PROMOCIÓN -->
<div class="top-bar" style="overflow: hidden; white-space: nowrap; text-align: left;">
  <div style="display: inline-flex; align-items: center; gap: 15vw; animation: marquee-seamless 30s linear infinite;">
    <span>🚨 Ultimas unidades disponibles🚨</span>
    <span>🌿 Envíos gratis a toda Colombia 🌿</span>
    <span>🚚 Pago contra entrega a todo el país 🚚</span>
    <!-- Contenido duplicado para el bucle infinito -->
    <span>🚨 Ultimas unidades disponibles🚨</span>
    <span>🇨🇴 Envíos gratis a toda Colombia  🇨🇴</span>
    <span>🚚 Pago contra entrega a todo el país 🚚</span>
  </div>
  <style>
    @keyframes marquee-seamless {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
  </style>
</div>

<!-- HEADER -->
<header>
  <!-- Navegación Izquierda -->
  <div class="left-nav">
    <div class="menu-icon" onclick="toggleSidebar()">
      <span class="menu-text" style="font-size: 14px; font-weight: 500; text-transform: uppercase; letter-spacing: 1px;">Nuestros Productos</span>
      <svg class="menu-hamburger" viewBox="0 0 24 24" style="display: none; width: 28px; height: 28px;"><path fill="currentColor" d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"></path></svg>
    </div>
  </div>

  <!-- Logo Céntrico -->
  <a href="/" class="logo-simulado" style="display:flex; align-items:center; text-decoration:none;">

  {% if section.settings.logo != blank %}
    <img 
      src="{{ section.settings.logo | image_url: width: 400 }}" 
      alt="{{ shop.name }}" 
      width="400" height="100"
      style="max-height: {{ section.settings.logo_height }}px; width:auto; margin-right:12px;">
  {% endif %}

  <div style="display:flex; flex-direction:column; line-height:1;">

    <span style="
      font-family: 'Playfair Display', serif;
      font-size: 26px;
      font-weight: 500;
      color:#6f6f6f;
      letter-spacing: 0.5px;">
      Dianamar
    </span>

    <span style="
      font-family: 'Inter', sans-serif;
      font-size:11px;
      font-weight: 400;
      letter-spacing:4px;
      color:#8fa38f;
      margin-top:2px;">
      HOGAR
    </span>

  </div>
</a>

</header>

<!-- WhatsApp Button Removed -->
<style>
  /* RESPONSIVE: TABLETS (max-width: 900px) */
  @media (max-width: 900px) {
    header { padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; }
    .left-nav { gap: 10px; }
    .menu-text { display: none !important; }
    .menu-hamburger { display: block !important; }
    .logo-simulado { margin-left: 0; }
    .logo-img { height: 35px; }
  }

  /* RESPONSIVE: PHONES (max-width: 768px) */
  @media (max-width: 768px) {
    .top-bar { font-size: 10px; padding: 7px 10px; }
    header { padding: 10px 15px; }
    .logo-img { height: 30px; }
    .logo-dianamar { font-size: 20px; }
    .sidebar { width: 280px; }
  }

  /* RESPONSIVE: SMALL PHONES (max-width: 480px) */
  @media (max-width: 480px) {
    header { padding: 8px 12px; }
    .top-bar { font-size: 9px; padding: 6px 10px; }
    .logo-img { height: 26px; }
    .logo-dianamar { font-size: 18px; }
    .sidebar { width: 260px; }
    .sidebar-header { padding: 18px 15px; }
    .sidebar-links > li > a, .submenu-toggle { padding: 15px 18px; font-size: 13px; }
    .submenu li a { padding: 12px 18px 12px 35px; font-size: 13px; }
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo de la Tienda"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Altura del Logo",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 35,
      "unit": "px"
    },
    {
      "type": "radio",
      "id": "menu_type",
      "label": "Origen del Menú",
      "options": [
        { "value": "automatic", "label": "Listar todas las Colecciones automáticamente" },
        { "value": "manual", "label": "Menú manual (Configurado en Navegación)" }
      ],
      "default": "automatic"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú manual a mostrar (si eliges manual arriba)",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
