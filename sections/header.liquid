{%- comment -%}
  Encabezado de la tienda nueva: barra de anuncios, logo, menú de categorías,
  buscador, cuenta y cesta. En celular el menú se abre en un panel lateral.
  Las categorías del menú son bloques "Enlace" editables desde Personalizar.
{%- endcomment -%}
{%- liquid
  assign anuncios = ''
  if section.settings.announce_1 != blank
    assign anuncios = anuncios | append: section.settings.announce_1 | append: '|'
  endif
  if section.settings.announce_2 != blank
    assign anuncios = anuncios | append: section.settings.announce_2 | append: '|'
  endif
  if section.settings.announce_3 != blank
    assign anuncios = anuncios | append: section.settings.announce_3 | append: '|'
  endif
  assign anuncios = anuncios | split: '|'
-%}

{%- if anuncios.size > 0 -%}
  <div class="dh-announce" role="region" aria-label="Anuncios">
    <ul>
      {%- for a in anuncios -%}<li>{{ a }}</li>{%- endfor -%}
    </ul>
  </div>
{%- endif -%}

<header class="dh-header">
  <div class="dh-header-inner">
    <button type="button" class="dh-icon-btn dh-menu-btn" data-dh-open-menu aria-label="Abrir menú" aria-controls="dh-menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>

    <a href="{{ routes.root_url }}" class="dh-logo" aria-label="{{ shop.name }}, ir al inicio">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 160 }}" alt="" width="80" height="80" style="height: {{ section.settings.logo_height | default: 44 }}px;">
      {%- endif -%}
      <span class="dh-logo-text"><b>Dianamar</b><small>HOGAR</small></span>
    </a>

    <nav class="dh-nav" aria-label="Categorías">
      {%- for block in section.blocks -%}
        {%- if block.settings.title != blank -%}
          <a href="{{ block.settings.link | default: '#' }}" {% if block.settings.highlight %}style="color: var(--dh-coral-ink);"{% endif %} {% if request.path == block.settings.link %}aria-current="page"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.title }}</a>
        {%- endif -%}
      {%- else -%}
        {%- for link in linklists[section.settings.menu].links -%}
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      {%- endfor -%}
    </nav>

    <div class="dh-header-actions">
      {%- if section.settings.show_search -%}
        <button type="button" class="dh-icon-btn" data-dh-toggle-search aria-label="Buscar" aria-controls="dh-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        </button>
      {%- endif -%}
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="dh-icon-btn dh-account" aria-label="Mi cuenta">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="dh-icon-btn" data-dh-open-cart data-dh-cart-label aria-label="Cesta, {{ cart.item_count }} productos" aria-controls="dh-cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 016 0"/></svg>
        <span class="dh-cart-count" data-dh-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- if section.settings.show_search -%}
    <div class="dh-search" id="dh-search" data-dh-search hidden>
      <form action="{{ routes.search_url }}" method="get" role="search">
        <label class="dh-sr" for="dh-search-input">Buscar productos</label>
        <input id="dh-search-input" type="search" name="q" placeholder="¿Qué buscas? Ej. sábanas doble" value="{{ search.terms | escape }}">
        <input type="hidden" name="type" value="product">
        <button type="submit" class="dh-btn dh-btn-primary" style="min-height: 46px;">Buscar</button>
      </form>
    </div>
  {%- endif -%}
</header>

<!-- Menú lateral (celular) -->
<div class="dh-menu" id="dh-menu" data-dh-menu aria-hidden="true" role="dialog" aria-label="Menú">
  <div class="dh-menu-head">
    <span>Menú</span>
    <button type="button" class="dh-icon-btn" data-dh-close aria-label="Cerrar menú">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <nav aria-label="Categorías">
    <a href="{{ routes.root_url }}">Inicio</a>
    {%- for block in section.blocks -%}
      {%- if block.settings.title != blank -%}
        <a href="{{ block.settings.link | default: '#' }}" {% if block.settings.highlight %}style="color: var(--dh-coral-ink);"{% endif %}>
          {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 80 }}" alt="" width="36" height="36" loading="lazy" style="width:36px;height:36px;border-radius:50%;object-fit:cover;">{%- endif -%}
          {{ block.settings.title }}
        </a>
      {%- endif -%}
    {%- else -%}
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    {%- endfor -%}
    <a href="{{ routes.all_products_collection_url }}">Ver toda la tienda</a>
  </nav>
  {%- if section.settings.whatsapp != blank -%}
    <div class="dh-menu-help">¿Dudas con el tamaño? Escríbenos por WhatsApp<br><a class="dh-link" href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' }}">{{ section.settings.whatsapp }}</a></div>
  {%- endif -%}
</div>

{% render 'dh-cart-drawer', upsell_product: section.settings.upsell_product, upsell_heading: section.settings.upsell_heading %}

{% schema %}
{
  "name": "Encabezado",
  "max_blocks": 10,
  "settings": [
    { "type": "header", "content": "Barra de anuncios" },
    { "type": "text", "id": "announce_1", "label": "Anuncio 1", "default": "Pago contra entrega en toda Colombia" },
    { "type": "text", "id": "announce_2", "label": "Anuncio 2", "default": "Paga anticipado con Mercado Pago" },
    { "type": "text", "id": "announce_3", "label": "Anuncio 3", "default": "Envío de 2 a 5 días hábiles" },
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo de la tienda" },
    { "type": "range", "id": "logo_height", "label": "Altura del logo", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 44 },
    { "type": "header", "content": "Menú" },
    { "type": "paragraph", "content": "Agrega las categorías del menú como bloques \"Enlace\". Si no hay bloques, se usa el menú de Navegación elegido abajo." },
    { "type": "link_list", "id": "menu", "label": "Menú de respaldo", "default": "main-menu" },
    { "type": "checkbox", "id": "show_search", "label": "Mostrar buscador", "default": true },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp de ayuda (con indicativo)", "default": "+57 322 343 8327" },
    { "type": "header", "content": "Cesta" },
    { "type": "product", "id": "upsell_product", "label": "Producto sugerido en la cesta", "info": "Se ofrece dentro de la cesta para que agreguen algo más (ej. fundas)." },
    { "type": "text", "id": "upsell_heading", "label": "Texto del producto sugerido", "default": "Completa tu cama" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Enlace",
      "settings": [
        { "type": "text", "id": "title", "label": "Texto", "default": "Sábanas" },
        { "type": "url", "id": "link", "label": "Enlace" },
        { "type": "image_picker", "id": "image", "label": "Imagen (menú del celular)" },
        { "type": "checkbox", "id": "highlight", "label": "Resaltar (ej. Ofertas)", "default": false }
      ]
    }
  ]
}
{% endschema %}
