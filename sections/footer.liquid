{%- comment -%}
  Footer de la tienda nueva. En computador se ven todas las columnas;
  en celular cada columna se abre como acordeón (assets/dh.js).
{%- endcomment -%}
<footer class="dh-footer">
  <div class="dh-wrap dh-footer-grid">
    <div class="dh-footer-col">
      <p class="dh-footer-brand">Dianamar Hogar</p>
      <p>{{ section.settings.about }}</p>
      <div class="dh-social">
        {%- if section.settings.whatsapp != blank -%}
          <a href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' }}" aria-label="WhatsApp" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.6.1a6.7 6.7 0 01-3.3-2.9c-.3-.4.2-.4.6-1.3.1-.2 0-.3 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 00-.7.3 3 3 0 00-.9 2.2 5.2 5.2 0 001.1 2.8 11.9 11.9 0 004.6 4 5.2 5.2 0 003.2.7 2.7 2.7 0 001.8-1.3 2.2 2.2 0 00.2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.instagram != blank -%}
          <a href="{{ section.settings.instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.tiktok != blank -%}
          <a href="{{ section.settings.tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.6 6.7a4.8 4.8 0 01-3.8-4.3V2h-3.4v13.7a2.9 2.9 0 11-2.1-2.8V9.4a6.3 6.3 0 105.5 6.3V8.7a8.1 8.1 0 004.8 1.5V6.8a4.9 4.9 0 01-1-.1z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.facebook != blank -%}
          <a href="{{ section.settings.facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.mercadolibre != blank -%}
          <a href="{{ section.settings.mercadolibre }}" aria-label="Mercado Libre" target="_blank" rel="noopener">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="24" cy="24" rx="19.5" ry="13"/><path d="M17.3 20.1c0 .8 1.3 1.3 2.4.7.6-.3 3.3-2.9 5.5-2.9s9.2 7.1 9.9 7.8c1 1-.9 3.3-2.2 2.1"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <details class="dh-footer-col" open>
      <summary><h2>Tienda</h2></summary>
      <ul>
        {%- for link in linklists[section.settings.menu_shop].links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- else -%}
          <li><a href="{{ routes.all_products_collection_url }}">Ver todos los productos</a></li>
        {%- endfor -%}
      </ul>
    </details>

    <details class="dh-footer-col" open>
      <summary><h2>Contacto</h2></summary>
      <ul>
        {%- if section.settings.city != blank -%}<li>{{ section.settings.city }}</li>{%- endif -%}
        {%- if section.settings.whatsapp != blank -%}<li><a href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' }}">{{ section.settings.whatsapp }}</a></li>{%- endif -%}
        {%- if section.settings.email != blank -%}<li><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li>{%- endif -%}
        <li style="margin-top: 6px; font-size: 13px;">Pagos: contra entrega · Mercado Pago</li>
      </ul>
    </details>

    <details class="dh-footer-col" open>
      <summary><h2>Cambios y devoluciones</h2></summary>
      <p style="font-size: 14px;">{{ section.settings.policy_short }}</p>
      {%- if section.settings.policy_long != blank -%}
        <details style="margin-top: 8px;">
          <summary style="font-size: 14px; min-height: 36px;">Leer la política completa</summary>
          <p style="font-size: 13px; line-height: 1.6; margin-top: 6px;">{{ section.settings.policy_long }}</p>
        </details>
      {%- endif -%}
    </details>
  </div>
  <div class="dh-wrap dh-footer-bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados.</span>
    <span>Bogotá, Colombia</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "about", "label": "Sobre nosotros", "default": "Lencería para el hogar que combina estética, confort y calidad: sábanas, protectores, colchas, cobijas y toallas con estilos modernos y tonos armoniosos." },
    { "type": "link_list", "id": "menu_shop", "label": "Menú de la columna Tienda", "info": "Si está vacío, se muestra un enlace a todos los productos." },
    { "type": "text", "id": "city", "label": "Ciudad", "default": "Bogotá, Colombia" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp", "default": "+57 322 343 8327" },
    { "type": "text", "id": "email", "label": "Correo", "default": "dianamarhogar@gmail.com" },
    { "type": "text", "id": "instagram", "label": "Instagram", "default": "https://www.instagram.com/dianamarhogar/" },
    { "type": "text", "id": "tiktok", "label": "TikTok", "default": "https://www.tiktok.com/@dianamarhogar" },
    { "type": "text", "id": "facebook", "label": "Facebook" },
    { "type": "text", "id": "mercadolibre", "label": "Mercado Libre", "default": "https://www.mercadolibre.com.co/pagina/dianamarhogarlenceria" },
    { "type": "textarea", "id": "policy_short", "label": "Política de cambios (resumen)", "default": "Garantía de hasta 90 días por defectos de fabricación. Si recibes un producto diferente al pedido, lo cambiamos sin costo." },
    { "type": "textarea", "id": "policy_long", "label": "Política de cambios (completa)" }
  ]
}
{% endschema %}
