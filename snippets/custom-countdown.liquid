<style>
.custom-countdown-wrapper {
  text-align: center;
  margin: 25px 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}
.countdown-text-1 {
  font-size: 18px;
  font-weight: 800;
  color: #111;
  text-transform: uppercase;
  margin-bottom: 6px;
  letter-spacing: 0.5px;
}
.countdown-text-2 {
  font-size: 26px;
  font-weight: 900;
  color: #000;
  text-transform: uppercase;
  margin-bottom: 25px;
  letter-spacing: 0.5px;
}
.countdown-timer-blocks {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 8px;
}
.countdown-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.countdown-box {
  background-color: #f1f1f1;
  border-radius: 12px;
  width: 58px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}
.countdown-num {
  font-size: 28px;
  font-weight: 800;
  color: #000;
  line-height: 1;
}
.countdown-label {
  font-size: 14px;
  color: #555;
  font-weight: 600;
}
.countdown-sep {
  font-size: 28px;
  font-weight: 800;
  color: #000;
  margin-top: 14px;
}

@media (max-width: 480px) {
  .countdown-text-1 { font-size: 15px; }
  .countdown-text-2 { font-size: 22px; margin-bottom: 20px; }
  .countdown-box { width: 50px; height: 56px; border-radius: 10px; }
  .countdown-num { font-size: 24px; }
  .countdown-sep { font-size: 24px; margin-top: 12px; }
  .countdown-timer-blocks { gap: 6px; }
}
</style>

<div class="custom-countdown-wrapper">
  <div class="countdown-text-1">{{ settings.countdown_text_1 | default: 'ESTAMOS DE OFERTA' }}</div>
  <div class="countdown-text-2">{{ settings.countdown_text_2 | default: 'HASTA 50% MENOS' }}</div>
  
  <div class="countdown-timer-blocks" data-hours="{{ settings.countdown_hours | default: 48 }}">
    <div class="countdown-col">
      <div class="countdown-box"><span class="countdown-num countdown-days">0</span></div>
      <span class="countdown-label">días</span>
    </div>
    <div class="countdown-sep">:</div>
    <div class="countdown-col">
      <div class="countdown-box"><span class="countdown-num countdown-hours">00</span></div>
      <span class="countdown-label">horas</span>
    </div>
    <div class="countdown-sep">:</div>
    <div class="countdown-col">
      <div class="countdown-box"><span class="countdown-num countdown-minutes">00</span></div>
      <span class="countdown-label">minutos</span>
    </div>
    <div class="countdown-sep">:</div>
    <div class="countdown-col">
      <div class="countdown-box"><span class="countdown-num countdown-seconds">00</span></div>
      <span class="countdown-label">segs</span>
    </div>
  </div>
</div>
